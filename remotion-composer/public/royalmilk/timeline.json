 "subtitles": [
  {
   "text": "ロイヤルミルクティー",
   "start": 0.27,
   "end": 1.17
  },
  {
   "text": "とミルクティー",
   "start": 1.17,
   "end": 2.49
  },
  {
   "text": "実は",
   "start": 2.49,
   "end": 3.03
  },
  {
   "text": "全くの別物なんです。",
   "start": 3.03,
   "end": 5.0
  },
  {
   "text": "ふつうのミルクティーは",
   "start": 5.0,
   "end": 6.25
  },
  {
   "text": "淹れた紅茶に",
   "start": 6.25,
   "end": 7.18
  },
  {
   "text": "あとから",
   "start": 7.18,
   "end": 7.69
  },
  {
   "text": "ミルクを注ぐだけ。",
   "start": 7.69,
   "end": 9.16
  },
  {
   "text": "紅茶の香りが",
   "start": 9.16,
   "end": 10.01
  },
  {
   "text": "すっきり立つ",
   "start": 10.01,
   "end": 10.55
  },
  {
   "text": "飲み方です。",
   "start": 10.55,
   "end": 11.71
  },
  {
   "text": "いっぽう",
   "start": 11.71,
   "end": 12.29
  },
  {
   "text": "ロイヤルミルクティーは",
   "start": 12.29,
   "end": 13.63
  },
  {
   "text": "茶葉を",
   "start": 13.63,
   "end": 13.95
  },
  {
   "text": "牛乳で",
   "start": 13.95,
   "end": 14.51
  },
  {
   "text": "じっくり煮出します。",
   "start": 14.51,
   "end": 15.96
  },
  {
   "text": "お湯は少しだけ",
   "start": 15.96,
   "end": 17.17
  },
  {
   "text": "牛乳たっぷりなので",
   "start": 17.17,
   "end": 18.55
  },
  {
   "text": "コクが深く",
   "start": 18.55,
   "end": 19.45
  },
  {
   "text": "まろやかに",
   "start": 19.45,
   "end": 19.97
  },
  {
   "text": "なるんです。",
   "start": 19.97,
   "end": 21.27
  },
  {
   "text": "しかもこの名前",
   "start": 21.27,
   "end": 22.53
  },
  {
   "text": "日本生まれの",
   "start": 22.53,
   "end": 23.31
  },
  {
   "text": "和製英語。",
   "start": 23.31,
   "end": 24.53
  },
  {
   "text": "イギリスには",
   "start": 24.53,
   "end": 25.31
  },
  {
   "text": "同じ名前の",
   "start": 25.31,
   "end": 25.95
  },
  {
   "text": "飲み物は",
   "start": 25.95,
   "end": 26.41
  },
  {
   "text": "ないんです。",
   "start": 26.41,
   "end": 27.56
  },
  {
   "text": "1965年ごろ",
   "start": 27.56,
   "end": 29.45
  },
  {
   "text": "京都の紅茶店が",
   "start": 29.45,
   "end": 30.43
  },
  {
   "text": "出したのが",
   "start": 30.43,
   "end": 30.95
  },
  {
   "text": "始まりとも",
   "start": 30.95,
   "end": 31.47
  },
  {
   "text": "言われます。",
   "start": 31.47,
   "end": 32.66
  },
  {
   "text": "おいしく作るコツは",
   "start": 32.66,
   "end": 33.99
  },
  {
   "text": "先に少しのお湯で",
   "start": 33.99,
   "end": 35.17
  },
  {
   "text": "茶葉を開くこと。",
   "start": 35.17,
   "end": 36.71
  },
  {
   "text": "牛乳を入れたら",
   "start": 36.71,
   "end": 37.63
  },
  {
   "text": "沸騰する手前で",
   "start": 37.63,
   "end": 38.65
  },
  {
   "text": "火を止めます。",
   "start": 38.65,
   "end": 39.89
  },
  {
   "text": "違いを知って",
   "start": 39.89,
   "end": 40.74
  },
  {
   "text": "その日の気分で",
   "start": 40.74,
   "end": 41.61
  },
  {
   "text": "飲み分けてみて",
   "start": 41.61,
   "end": 42.15
  },
  {
   "text": "ください。",
   "start": 42.15,
   "end": 44.87
  }
 ],
 "mouth": []
