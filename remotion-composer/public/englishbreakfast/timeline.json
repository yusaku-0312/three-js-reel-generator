 "subtitles": [
  {
   "text": "紅茶の本場",
   "start": 0.28,
   "end": 1.0
  },
  {
   "text": "イギリスで",
   "start": 1.0,
   "end": 1.75
  },
  {
   "text": "最も愛されている",
   "start": 1.75,
   "end": 2.96
  },
  {
   "text": "紅茶は何だと",
   "start": 2.96,
   "end": 3.848
  },
  {
   "text": "思いますか？",
   "start": 3.848,
   "end": 5.15
  },
  {
   "text": "アールグレイ？",
   "start": 5.15,
   "end": 5.73
  },
  {
   "text": "ダージリン？",
   "start": 5.73,
   "end": 7.09
  },
  {
   "text": "それとも",
   "start": 7.09,
   "end": 7.52
  },
  {
   "text": "アッサム？",
   "start": 7.52,
   "end": 8.44
  },
  {
   "text": "実はイギリスで",
   "start": 8.44,
   "end": 9.34
  },
  {
   "text": "最も飲まれている",
   "start": 9.34,
   "end": 10.68
  },
  {
   "text": "紅茶は",
   "start": 10.68,
   "end": 11.06
  },
  {
   "text": "イングリッシュ",
   "start": 11.06,
   "end": 12.15
  },
  {
   "text": "ブレックファスト。",
   "start": 12.15,
   "end": 13.86
  },
  {
   "text": "2020年の調査で",
   "start": 13.86,
   "end": 15.47
  },
  {
   "text": "54%の人が",
   "start": 15.47,
   "end": 16.44
  },
  {
   "text": "飲んでいると",
   "start": 16.44,
   "end": 17.63
  },
  {
   "text": "回答し、",
   "start": 17.63,
   "end": 18.72
  },
  {
   "text": "18%だった",
   "start": 18.72,
   "end": 19.86
  },
  {
   "text": "アールグレイを",
   "start": 19.86,
   "end": 20.5
  },
  {
   "text": "大きく上回りました。",
   "start": 20.5,
   "end": 21.6
  },
  {
   "text": "では",
   "start": 21.6,
   "end": 22.27
  },
  {
   "text": "なぜこれほど",
   "start": 22.27,
   "end": 22.78
  },
  {
   "text": "人気なのでしょうか？",
   "start": 22.78,
   "end": 24.08
  },
  {
   "text": "イングリッシュ",
   "start": 24.08,
   "end": 25.33
  },
  {
   "text": "ブレックファストは",
   "start": 25.33,
   "end": 26.88
  },
  {
   "text": "アッサムや",
   "start": 26.88,
   "end": 27.27
  },
  {
   "text": "セイロンなど",
   "start": 27.27,
   "end": 28.38
  },
  {
   "text": "複数の茶葉を",
   "start": 28.38,
   "end": 29.07
  },
  {
   "text": "組み合わせた",
   "start": 29.07,
   "end": 29.91
  },
  {
   "text": "ブレンドティー。",
   "start": 29.91,
   "end": 31.27
  },
  {
   "text": "しっかりとした",
   "start": 31.27,
   "end": 32.0
  },
  {
   "text": "コクと豊かな",
   "start": 32.0,
   "end": 32.83
  },
  {
   "text": "風味が特徴です。",
   "start": 32.83,
   "end": 34.39
  },
  {
   "text": "ミルクを加えても",
   "start": 34.39,
   "end": 35.21
  },
  {
   "text": "紅茶の味わいが",
   "start": 35.21,
   "end": 36.26
  },
  {
   "text": "残りやすく",
   "start": 36.26,
   "end": 37.85
  },
  {
   "text": "ミルクティーにも",
   "start": 37.85,
   "end": 38.91
  },
  {
   "text": "適しています。",
   "start": 38.91,
   "end": 39.87
  },
  {
   "text": "実際",
   "start": 39.87,
   "end": 40.5
  },
  {
   "text": "イギリスでは",
   "start": 40.5,
   "end": 40.85
  },
  {
   "text": "イングリッシュ",
   "start": 40.85,
   "end": 41.39
  },
  {
   "text": "ブレックファストや",
   "start": 41.39,
   "end": 42.55
  },
  {
   "text": "アールグレイを",
   "start": 42.55,
   "end": 43.19
  },
  {
   "text": "飲む人の",
   "start": 43.19,
   "end": 43.89
  },
  {
   "text": "85%が",
   "start": 43.89,
   "end": 45.18
  },
  {
   "text": "ミルクを加えて",
   "start": 45.18,
   "end": 45.92
  },
  {
   "text": "楽しんでいる",
   "start": 45.92,
   "end": 47.3
  },
  {
   "text": "調査結果も",
   "start": 47.3,
   "end": 48.44
  },
  {
   "text": "あります。",
   "start": 48.44,
   "end": 48.77
  },
  {
   "text": "また名前の通り",
   "start": 48.77,
   "end": 50.08
  },
  {
   "text": "朝食との相性も",
   "start": 50.08,
   "end": 51.13
  },
  {
   "text": "考えられた",
   "start": 51.13,
   "end": 51.91
  },
  {
   "text": "紅茶です。",
   "start": 51.91,
   "end": 53.02
  },
  {
   "text": "パンや卵料理などと",
   "start": 53.02,
   "end": 54.37
  },
  {
   "text": "一緒に飲む",
   "start": 54.37,
   "end": 55.03
  },
  {
   "text": "日常の一杯として",
   "start": 55.03,
   "end": 56.03
  },
  {
   "text": "親しまれて",
   "start": 56.03,
   "end": 56.89
  },
  {
   "text": "きました。",
   "start": 56.89,
   "end": 57.66
  },
  {
   "text": "特別な日の",
   "start": 57.66,
   "end": 58.34
  },
  {
   "text": "高級な紅茶",
   "start": 58.34,
   "end": 59.04
  },
  {
   "text": "だけではなく",
   "start": 59.04,
   "end": 60.0
  },
  {
   "text": "毎日の暮らしに",
   "start": 60.0,
   "end": 61.45
  },
  {
   "text": "寄り添う紅茶が",
   "start": 61.45,
   "end": 62.46
  },
  {
   "text": "選ばれている",
   "start": 62.46,
   "end": 64.44
  },
  {
   "text": "のです。",
   "start": 64.44,
   "end": 64.66
  },
  {
   "text": "ちなみに皆さんの",
   "start": 64.66,
   "end": 65.48
  },
  {
   "text": "一番好きな",
   "start": 65.48,
   "end": 66.22
  },
  {
   "text": "紅茶は？",
   "start": 66.22,
   "end": 67.29
  },
  {
   "text": "ぜひコメントで",
   "start": 67.29,
   "end": 68.35
  },
  {
   "text": "教えてください！",
   "start": 68.35,
   "end": 71.55
  }
