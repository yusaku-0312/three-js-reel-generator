 "subtitles": [
  {
   "text": "アフタヌーンティーの",
   "start": 0.26,
   "end": 1.17
  },
  {
   "text": "次に",
   "start": 1.17,
   "end": 1.71
  },
  {
   "text": "ホテルで増えているのが",
   "start": 1.71,
   "end": 3.13
  },
  {
   "text": "「ハイティー」。",
   "start": 3.13,
   "end": 4.23
  },
  {
   "text": "この「ハイ」",
   "start": 4.23,
   "end": 5.65
  },
  {
   "text": "何が高いと",
   "start": 5.65,
   "end": 6.25
  },
  {
   "text": "思いますか？",
   "start": 6.25,
   "end": 7.43
  },
  {
   "text": "答えは",
   "start": 7.43,
   "end": 8.19
  },
  {
   "text": "値段ではなく",
   "start": 8.19,
   "end": 9.2
  },
  {
   "text": "テーブルの高さ。",
   "start": 9.2,
   "end": 11.11
  },
  {
   "text": "ハイティーはもともと",
   "start": 11.11,
   "end": 12.87
  },
  {
   "text": "高い食卓で食べる",
   "start": 12.87,
   "end": 14.45
  },
  {
   "text": "働く人たちの",
   "start": 14.45,
   "end": 15.5
  },
  {
   "text": "晩ごはんだったと",
   "start": 15.5,
   "end": 16.11
  },
  {
   "text": "言われます。",
   "start": 16.11,
   "end": 18.28
  },
  {
   "text": "19世紀のイギリス。",
   "start": 18.28,
   "end": 20.33
  },
  {
   "text": "上流階級は",
   "start": 20.33,
   "end": 20.79
  },
  {
   "text": "夕食が夜8時ごろと",
   "start": 20.79,
   "end": 22.85
  },
  {
   "text": "遅い時間でした。",
   "start": 22.85,
   "end": 24.29
  },
  {
   "text": "その前に",
   "start": 24.29,
   "end": 25.15
  },
  {
   "text": "ソファの前の",
   "start": 25.15,
   "end": 26.08
  },
  {
   "text": "低いテーブルで",
   "start": 26.08,
   "end": 27.33
  },
  {
   "text": "紅茶とお菓子を",
   "start": 27.33,
   "end": 28.21
  },
  {
   "text": "楽しんだのが",
   "start": 28.21,
   "end": 29.05
  },
  {
   "text": "アフタヌーンティー。",
   "start": 29.05,
   "end": 30.61
  },
  {
   "text": "いっぽう",
   "start": 30.61,
   "end": 31.33
  },
  {
   "text": "工場や農場で",
   "start": 31.33,
   "end": 32.39
  },
  {
   "text": "働く人たちは",
   "start": 32.39,
   "end": 33.47
  },
  {
   "text": "仕事を終えると",
   "start": 33.47,
   "end": 34.73
  },
  {
   "text": "台所の高いテーブルで",
   "start": 34.73,
   "end": 36.69
  },
  {
   "text": "肉のパイや",
   "start": 36.69,
   "end": 37.51
  },
  {
   "text": "チーズトーストに",
   "start": 37.51,
   "end": 38.65
  },
  {
   "text": "熱い紅茶。",
   "start": 38.65,
   "end": 39.85
  },
  {
   "text": "おやつではなく",
   "start": 39.85,
   "end": 41.47
  },
  {
   "text": "一日のいちばん",
   "start": 41.47,
   "end": 42.21
  },
  {
   "text": "大事な食事でした。",
   "start": 42.21,
   "end": 43.75
  },
  {
   "text": "では",
   "start": 43.75,
   "end": 44.45
  },
  {
   "text": "日本でハイティーを",
   "start": 44.45,
   "end": 45.43
  },
  {
   "text": "楽しむなら？",
   "start": 45.43,
   "end": 46.69
  },
  {
   "text": "ホテルのハイティーは",
   "start": 46.69,
   "end": 47.84
  },
  {
   "text": "アフタヌーンティーより",
   "start": 47.84,
   "end": 48.93
  },
  {
   "text": "遅い",
   "start": 48.93,
   "end": 49.53
  },
  {
   "text": "夕方から夜の時間。",
   "start": 49.53,
   "end": 51.51
  },
  {
   "text": "甘いものより",
   "start": 51.51,
   "end": 52.41
  },
  {
   "text": "ローストビーフなどの",
   "start": 52.41,
   "end": 53.44
  },
  {
   "text": "食事が主役で",
   "start": 53.44,
   "end": 54.48
  },
  {
   "text": "シャンパンや",
   "start": 54.48,
   "end": 55.02
  },
  {
   "text": "カクテルがつく",
   "start": 55.02,
   "end": 55.69
  },
  {
   "text": "プランもあります。",
   "start": 55.69,
   "end": 57.01
  },
  {
   "text": "アフタヌーンティーは",
   "start": 57.01,
   "end": 58.15
  },
  {
   "text": "午後のおやつ",
   "start": 58.15,
   "end": 59.43
  },
  {
   "text": "ハイティーは",
   "start": 59.43,
   "end": 60.35
  },
  {
   "text": "早めの晩ごはん。",
   "start": 60.35,
   "end": 61.86
  },
  {
   "text": "仕事帰りの",
   "start": 61.86,
   "end": 62.93
  },
  {
   "text": "夕食がわりにも",
   "start": 62.93,
   "end": 63.74
  },
  {
   "text": "ぴったりなんです。",
   "start": 63.74,
   "end": 65.17
  },
  {
   "text": "家で楽しむなら",
   "start": 65.17,
   "end": 66.54
  },
  {
   "text": "晩ごはんに",
   "start": 66.54,
   "end": 67.08
  },
  {
   "text": "パイやチーズトーストを",
   "start": 67.08,
   "end": 68.35
  },
  {
   "text": "並べて",
   "start": 68.35,
   "end": 69.35
  },
  {
   "text": "熱い紅茶を",
   "start": 69.35,
   "end": 70.04
  },
  {
   "text": "ポットでどうぞ。",
   "start": 70.04,
   "end": 71.29
  },
  {
   "text": "ハイティーは",
   "start": 71.29,
   "end": 72.25
  },
  {
   "text": "今も昔も",
   "start": 72.25,
   "end": 73.29
  },
  {
   "text": "紅茶でいただく",
   "start": 73.29,
   "end": 74.17
  },
  {
   "text": "晩ごはんなんです。",
   "start": 74.17,
   "end": 77.13
  }
 ],
 "mouth": []
}