 "subtitles": [
  {
   "text": "ティーポットの紅茶で",
   "start": 0.28,
   "end": 2.31
  },
  {
   "text": "いちばんおいしい一滴は",
   "start": 2.31,
   "end": 3.17
  },
  {
   "text": "どこだと思いますか？",
   "start": 3.17,
   "end": 4.93
  },
  {
   "text": "注ぎはじめの一滴でも",
   "start": 4.93,
   "end": 6.79
  },
  {
   "text": "まん中でもありません。",
   "start": 6.79,
   "end": 8.34
  },
  {
   "text": "答えは",
   "start": 8.34,
   "end": 9.13
  },
  {
   "text": "ポットから",
   "start": 9.13,
   "end": 9.77
  },
  {
   "text": "最後に落ちる一滴。",
   "start": 9.77,
   "end": 11.71
  },
  {
   "text": "「ゴールデンドロップ」",
   "start": 11.71,
   "end": 12.76
  },
  {
   "text": "と呼ばれています。",
   "start": 12.76,
   "end": 14.57
  },
  {
   "text": "茶葉は",
   "start": 14.57,
   "end": 14.87
  },
  {
   "text": "ポットの底に",
   "start": 14.87,
   "end": 15.75
  },
  {
   "text": "沈んでいます。",
   "start": 15.75,
   "end": 17.15
  },
  {
   "text": "注いでいるあいだも",
   "start": 17.15,
   "end": 18.47
  },
  {
   "text": "茶葉から成分が",
   "start": 18.47,
   "end": 19.28
  },
  {
   "text": "溶け出し続けるので",
   "start": 19.28,
   "end": 20.71
  },
  {
   "text": "底に近いお茶ほど",
   "start": 20.71,
   "end": 21.85
  },
  {
   "text": "濃くなっていきます。",
   "start": 21.85,
   "end": 23.37
  },
  {
   "text": "最後の一滴には",
   "start": 23.37,
   "end": 24.81
  },
  {
   "text": "香りとうまみが",
   "start": 24.81,
   "end": 25.99
  },
  {
   "text": "ぎゅっと詰まっている",
   "start": 25.99,
   "end": 26.97
  },
  {
   "text": "と言われるんです。",
   "start": 26.97,
   "end": 28.53
  },
  {
   "text": "日本茶の急須でも",
   "start": 28.53,
   "end": 29.85
  },
  {
   "text": "最後の一滴まで",
   "start": 29.85,
   "end": 31.29
  },
  {
   "text": "注ぎきるのが",
   "start": 31.29,
   "end": 32.07
  },
  {
   "text": "大切とされてきました。",
   "start": 32.07,
   "end": 33.98
  },
  {
   "text": "イギリスの",
   "start": 33.98,
   "end": 34.47
  },
  {
   "text": "パーティーでは",
   "start": 34.47,
   "end": 35.3
  },
  {
   "text": "この一滴を",
   "start": 35.3,
   "end": 36.69
  },
  {
   "text": "大切なお客さまの",
   "start": 36.69,
   "end": 37.61
  },
  {
   "text": "カップに注ぐ",
   "start": 37.61,
   "end": 38.33
  },
  {
   "text": "習慣があるとされます。",
   "start": 38.33,
   "end": 40.59
  },
  {
   "text": "何杯か淹れるときは",
   "start": 40.59,
   "end": 41.76
  },
  {
   "text": "カップに少しずつ",
   "start": 41.76,
   "end": 43.25
  },
  {
   "text": "順番に注いで",
   "start": 43.25,
   "end": 44.19
  },
  {
   "text": "濃さをそろえます。",
   "start": 44.19,
   "end": 45.63
  },
  {
   "text": "そして最後の",
   "start": 45.63,
   "end": 47.47
  },
  {
   "text": "黄金の一滴で",
   "start": 47.47,
   "end": 48.27
  },
  {
   "text": "お客さまのカップを",
   "start": 48.27,
   "end": 49.31
  },
  {
   "text": "仕上げるんです。",
   "start": 49.31,
   "end": 50.73
  },
  {
   "text": "次の一杯",
   "start": 50.73,
   "end": 51.85
  },
  {
   "text": "その一滴は",
   "start": 51.85,
   "end": 53.37
  },
  {
   "text": "誰のカップに",
   "start": 53.37,
   "end": 53.99
  },
  {
   "text": "注ぎますか？",
   "start": 53.99,
   "end": 56.85
  }
 ],
