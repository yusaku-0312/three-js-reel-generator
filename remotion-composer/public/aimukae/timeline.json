 "subtitles": [
  {
   "text": "「知らない人に",
   "start": 0.41,
   "end": 1.06
  },
  {
   "text": "ついていかないで」",
   "start": 1.06,
   "end": 2.71
  },
  {
   "text": "そうお子さんに",
   "start": 2.71,
   "end": 3.4
  },
  {
   "text": "伝えるだけじゃ",
   "start": 3.4,
   "end": 4.3
  },
  {
   "text": "足りないかも",
   "start": 4.3,
   "end": 4.85
  },
  {
   "text": "しれません。",
   "start": 4.85,
   "end": 6.19
  },
  {
   "text": "今はAIで",
   "start": 6.19,
   "end": 7.22
  },
  {
   "text": "本人が話していない",
   "start": 7.22,
   "end": 8.34
  },
  {
   "text": "言葉も",
   "start": 8.34,
   "end": 8.91
  },
  {
   "text": "その人に似た声で",
   "start": 8.91,
   "end": 9.99
  },
  {
   "text": "作ることができます。",
   "start": 9.99,
   "end": 11.62
  },
  {
   "text": "たとえば",
   "start": 11.62,
   "end": 12.43
  },
  {
   "text": "下校中のお子さんに",
   "start": 12.43,
   "end": 13.89
  },
  {
   "text": "知らない男が",
   "start": 13.89,
   "end": 15.01
  },
  {
   "text": "「ママに頼まれて",
   "start": 15.01,
   "end": 15.83
  },
  {
   "text": "迎えに来たよ」と",
   "start": 15.83,
   "end": 17.01
  },
  {
   "text": "声をかけます。",
   "start": 17.01,
   "end": 18.29
  },
  {
   "text": "お子さんが断ると",
   "start": 18.29,
   "end": 19.56
  },
  {
   "text": "男は",
   "start": 19.56,
   "end": 20.43
  },
  {
   "text": "「じゃあ",
   "start": 20.43,
   "end": 20.77
  },
  {
   "text": "ママに確認しよう」と",
   "start": 20.77,
   "end": 22.19
  },
  {
   "text": "電話を差し出します。",
   "start": 22.19,
   "end": 23.69
  },
  {
   "text": "そこから",
   "start": 23.69,
   "end": 24.45
  },
  {
   "text": "ママそっくりの声で",
   "start": 24.45,
   "end": 25.97
  },
  {
   "text": "「その人と",
   "start": 25.97,
   "end": 26.47
  },
  {
   "text": "一緒に来てね」",
   "start": 26.47,
   "end": 27.87
  },
  {
   "text": "でも、それは",
   "start": 27.87,
   "end": 29.19
  },
  {
   "text": "男がAIで作った",
   "start": 29.19,
   "end": 30.45
  },
  {
   "text": "偽物の声。",
   "start": 30.45,
   "end": 31.99
  },
  {
   "text": "本当のママは",
   "start": 31.99,
   "end": 32.99
  },
  {
   "text": "迎えを",
   "start": 32.99,
   "end": 33.35
  },
  {
   "text": "頼んでいません。",
   "start": 33.35,
   "end": 34.79
  },
  {
   "text": "それでもお子さんは",
   "start": 34.79,
   "end": 36.01
  },
  {
   "text": "「ママが頼んだ",
   "start": 36.01,
   "end": 36.73
  },
  {
   "text": "人なんだ」と",
   "start": 36.73,
   "end": 37.59
  },
  {
   "text": "安心して",
   "start": 37.59,
   "end": 38.37
  },
  {
   "text": "車に乗って",
   "start": 38.37,
   "end": 39.01
  },
  {
   "text": "しまうかもしれません。",
   "start": 39.01,
   "end": 40.53
  },
  {
   "text": "ママに確認した",
   "start": 40.53,
   "end": 41.33
  },
  {
   "text": "つもりでも",
   "start": 41.33,
   "end": 42.11
  },
  {
   "text": "偽物の声を",
   "start": 42.11,
   "end": 42.98
  },
  {
   "text": "聞かされていただけ。",
   "start": 42.98,
   "end": 44.59
  },
  {
   "text": "そんな危険が",
   "start": 44.59,
   "end": 45.21
  },
  {
   "text": "あるんです。",
   "start": 45.21,
   "end": 46.15
  },
  {
   "text": "だから",
   "start": 46.15,
   "end": 46.7
  },
  {
   "text": "パパさん・ママさん。",
   "start": 46.7,
   "end": 48.06
  },
  {
   "text": "親子で",
   "start": 48.06,
   "end": 48.57
  },
  {
   "text": "3つの約束を",
   "start": 48.57,
   "end": 49.35
  },
  {
   "text": "しておきましょう。",
   "start": 49.35,
   "end": 50.61
  },
  {
   "text": "まず",
   "start": 50.61,
   "end": 51.34
  },
  {
   "text": "親子だけの",
   "start": 51.34,
   "end": 52.03
  },
  {
   "text": "合言葉を",
   "start": 52.03,
   "end": 52.55
  },
  {
   "text": "決めておきましょう。",
   "start": 52.55,
   "end": 54.01
  },
  {
   "text": "合言葉は",
   "start": 54.01,
   "end": 54.97
  },
  {
   "text": "声に加えて",
   "start": 54.97,
   "end": 56.09
  },
  {
   "text": "「家族だけが",
   "start": 56.09,
   "end": 56.75
  },
  {
   "text": "知っていることに",
   "start": 56.75,
   "end": 57.47
  },
  {
   "text": "答えられるか」でも",
   "start": 57.47,
   "end": 59.25
  },
  {
   "text": "本人かを",
   "start": 59.25,
   "end": 59.7
  },
  {
   "text": "確かめるための",
   "start": 59.7,
   "end": 60.43
  },
  {
   "text": "ものです。",
   "start": 60.43,
   "end": 61.69
  },
  {
   "text": "電話で",
   "start": 61.69,
   "end": 62.35
  },
  {
   "text": "「ママだよ」と",
   "start": 62.35,
   "end": 63.05
  },
  {
   "text": "言われたら",
   "start": 63.05,
   "end": 63.84
  },
  {
   "text": "「合言葉は？」と聞く。",
   "start": 63.84,
   "end": 65.67
  },
  {
   "text": "自分から",
   "start": 65.67,
   "end": 66.18
  },
  {
   "text": "答えを言わず",
   "start": 66.18,
   "end": 67.23
  },
  {
   "text": "相手に",
   "start": 67.23,
   "end": 67.62
  },
  {
   "text": "答えてもらいます。",
   "start": 67.62,
   "end": 69.23
  },
  {
   "text": "名前や誕生日など",
   "start": 69.23,
   "end": 70.66
  },
  {
   "text": "人に知られやすい",
   "start": 70.66,
   "end": 71.45
  },
  {
   "text": "ものは避けて",
   "start": 71.45,
   "end": 72.5
  },
  {
   "text": "家族以外には",
   "start": 72.5,
   "end": 73.35
  },
  {
   "text": "教えない言葉に",
   "start": 73.35,
   "end": 74.13
  },
  {
   "text": "してください。",
   "start": 74.13,
   "end": 75.34
  },
  {
   "text": "ただ、合言葉も",
   "start": 75.34,
   "end": 76.89
  },
  {
   "text": "誰かに",
   "start": 76.89,
   "end": 77.29
  },
  {
   "text": "知られてしまう",
   "start": 77.29,
   "end": 77.86
  },
  {
   "text": "可能性はあります。",
   "start": 77.86,
   "end": 79.4
  },
  {
   "text": "だから",
   "start": 79.4,
   "end": 80.07
  },
  {
   "text": "答えが合っていても",
   "start": 80.07,
   "end": 81.37
  },
  {
   "text": "次は自分から",
   "start": 81.37,
   "end": 82.25
  },
  {
   "text": "親に掛け直しましょう。",
   "start": 82.25,
   "end": 83.95
  },
  {
   "text": "相手が差し出した",
   "start": 83.95,
   "end": 84.95
  },
  {
   "text": "電話では",
   "start": 84.95,
   "end": 85.66
  },
  {
   "text": "相手が用意した",
   "start": 85.66,
   "end": 86.65
  },
  {
   "text": "偽物の声を",
   "start": 86.65,
   "end": 87.43
  },
  {
   "text": "聞かされているかも",
   "start": 87.43,
   "end": 88.23
  },
  {
   "text": "しれません。",
   "start": 88.23,
   "end": 89.51
  },
  {
   "text": "自分の携帯から",
   "start": 89.51,
   "end": 90.73
  },
  {
   "text": "前から登録してある",
   "start": 90.73,
   "end": 91.85
  },
  {
   "text": "親の番号へ掛けて",
   "start": 91.85,
   "end": 93.3
  },
  {
   "text": "「この人に迎えを",
   "start": 93.3,
   "end": 94.12
  },
  {
   "text": "頼んだ？」と聞く。",
   "start": 94.12,
   "end": 95.97
  },
  {
   "text": "声だけでなく",
   "start": 95.97,
   "end": 96.99
  },
  {
   "text": "迎えを頼んだ",
   "start": 96.99,
   "end": 97.85
  },
  {
   "text": "事実まで",
   "start": 97.85,
   "end": 98.32
  },
  {
   "text": "確認するんです。",
   "start": 98.32,
   "end": 99.93
  },
  {
   "text": "そして",
   "start": 99.93,
   "end": 100.71
  },
  {
   "text": "親につながらなかった",
   "start": 100.71,
   "end": 101.76
  },
  {
   "text": "ときの行動も",
   "start": 101.76,
   "end": 102.75
  },
  {
   "text": "先に決めて",
   "start": 102.75,
   "end": 103.29
  },
  {
   "text": "おきましょう。",
   "start": 103.29,
   "end": 104.35
  },
  {
   "text": "「急いで」",
   "start": 104.35,
   "end": 105.01
  },
  {
   "text": "「ママが待ってる」と",
   "start": 105.01,
   "end": 106.07
  },
  {
   "text": "言われても",
   "start": 106.07,
   "end": 106.94
  },
  {
   "text": "確認できるまでは",
   "start": 106.94,
   "end": 107.95
  },
  {
   "text": "ついていかない。",
   "start": 107.95,
   "end": 109.35
  },
  {
   "text": "携帯がないときも",
   "start": 109.35,
   "end": 110.63
  },
  {
   "text": "先生や",
   "start": 110.63,
   "end": 111.05
  },
  {
   "text": "お店の人に",
   "start": 111.05,
   "end": 111.99
  },
  {
   "text": "「親に連絡したいです。",
   "start": 111.99,
   "end": 113.34
  },
  {
   "text": "助けてください」と",
   "start": 113.34,
   "end": 114.63
  },
  {
   "text": "相談するよう",
   "start": 114.63,
   "end": 115.24
  },
  {
   "text": "伝えてください。",
   "start": 115.24,
   "end": 116.45
  },
  {
   "text": "いざというときに",
   "start": 116.45,
   "end": 117.33
  },
  {
   "text": "迷わないよう",
   "start": 117.33,
   "end": 118.43
  },
  {
   "text": "通学路のどこで",
   "start": 118.43,
   "end": 119.19
  },
  {
   "text": "助けを求められるかも",
   "start": 119.19,
   "end": 120.6
  },
  {
   "text": "親子で",
   "start": 120.6,
   "end": 121.12
  },
  {
   "text": "確認しておくと",
   "start": 121.12,
   "end": 121.93
  },
  {
   "text": "安心です。",
   "start": 121.93,
   "end": 123.13
  },
  {
   "text": "最後に",
   "start": 123.13,
   "end": 123.93
  },
  {
   "text": "お子さんには",
   "start": 123.93,
   "end": 124.65
  },
  {
   "text": "こう伝えてください。",
   "start": 124.65,
   "end": 126.45
  },
  {
   "text": "「迎えに来たと",
   "start": 126.45,
   "end": 127.09
  },
  {
   "text": "言われても",
   "start": 127.09,
   "end": 127.79
  },
  {
   "text": "確認できなければ",
   "start": 127.79,
   "end": 128.74
  },
  {
   "text": "断っていいよ。",
   "start": 128.74,
   "end": 130.04
  },
  {
   "text": "困ったら",
   "start": 130.04,
   "end": 130.69
  },
  {
   "text": "一人で決めずに",
   "start": 130.69,
   "end": 131.59
  },
  {
   "text": "助けを求めてね」",
   "start": 131.59,
   "end": 133.15
  },
  {
   "text": "今日",
   "start": 133.15,
   "end": 133.73
  },
  {
   "text": "お子さんと",
   "start": 133.73,
   "end": 134.54
  },
  {
   "text": "合言葉と",
