 "subtitles": [
  {
   "text": "ミルクティーと",
   "start": 0.37,
   "end": 1.17
  },
  {
   "text": "ティーラテ、",
   "start": 1.17,
   "end": 2.41
  },
  {
   "text": "何が違うか",
   "start": 2.41,
   "end": 3.29
  },
  {
   "text": "知っていますか？",
   "start": 3.29,
   "end": 4.42
  },
  {
   "text": "ラテは",
   "start": 4.42,
   "end": 5.16
  },
  {
   "text": "イタリア語で",
   "start": 5.16,
   "end": 6.05
  },
  {
   "text": "「牛乳」のこと。",
   "start": 6.05,
   "end": 7.83
  },
  {
   "text": "ミルクティーは",
   "start": 7.83,
   "end": 8.82
  },
  {
   "text": "淹れた紅茶に",
   "start": 8.82,
   "end": 9.75
  },
  {
   "text": "ミルクを少し",
   "start": 9.75,
   "end": 10.79
  },
  {
   "text": "加えたもの。",
   "start": 10.79,
   "end": 12.11
  },
  {
   "text": "主役は",
   "start": 12.11,
   "end": 12.73
  },
  {
   "text": "あくまで紅茶です。",
   "start": 12.73,
   "end": 14.63
  },
  {
   "text": "いっぽう",
   "start": 14.63,
   "end": 15.17
  },
  {
   "text": "ティーラテは",
   "start": 15.17,
   "end": 15.98
  },
  {
   "text": "濃く淹れた紅茶に",
   "start": 15.98,
   "end": 17.35
  },
  {
   "text": "蒸気で温めた",
   "start": 17.35,
   "end": 18.07
  },
  {
   "text": "ミルクをたっぷり。",
   "start": 18.07,
   "end": 19.92
  },
  {
   "text": "最後に",
   "start": 19.92,
   "end": 20.65
  },
  {
   "text": "ふわふわの泡を",
   "start": 20.65,
   "end": 21.55
  },
  {
   "text": "のせます。",
   "start": 21.55,
   "end": 22.65
  },
  {
   "text": "お店によっては",
   "start": 22.65,
   "end": 23.89
  },
  {
   "text": "紅茶とミルクが",
   "start": 23.89,
   "end": 24.71
  },
  {
   "text": "半分ずつ",
   "start": 24.71,
   "end": 25.48
  },
  {
   "text": "ということも。",
   "start": 25.48,
   "end": 26.69
  },
  {
   "text": "紅茶の香りなら",
   "start": 26.69,
   "end": 27.87
  },
  {
   "text": "ミルクティー、",
   "start": 27.87,
   "end": 28.81
  },
  {
   "text": "まろやかさなら",
   "start": 28.81,
   "end": 29.78
  },
  {
   "text": "ティーラテです。",
   "start": 29.78,
   "end": 31.04
  },
  {
   "text": "その日の気分で",
   "start": 31.04,
   "end": 32.21
  },
  {
   "text": "選んでみてください。",
   "start": 32.21,
   "end": 35.25
  }
 ],
