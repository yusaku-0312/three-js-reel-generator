 "subtitles": [
  {
   "text": "IVEのウォニョンも",
   "start": 0.37,
   "end": 1.42
  },
  {
   "text": "この表情になる",
   "start": 1.42,
   "end": 2.32
  },
  {
   "text": "CHAGEEですが、",
   "start": 2.32,
   "end": 3.71
  },
  {
   "text": "中国・雲南省で",
   "start": 3.71,
   "end": 5.33
  },
  {
   "text": "2017年に生まれた",
   "start": 5.33,
   "end": 6.79
  },
  {
   "text": "お茶のお店です。",
   "start": 6.79,
   "end": 8.32
  },
  {
   "text": "ウォニョンは今年1月",
   "start": 8.32,
   "end": 10.45
  },
  {
   "text": "中国でのライブ配信で",
   "start": 10.45,
   "end": 11.93
  },
  {
   "text": "ここのミルクティーを",
   "start": 11.93,
   "end": 13.05
  },
  {
   "text": "「すごくおいしい」と",
   "start": 13.05,
   "end": 14.17
  },
  {
   "text": "言って話題に。",
   "start": 14.17,
   "end": 15.84
  },
  {
   "text": "看板メニューは",
   "start": 15.84,
   "end": 16.83
  },
  {
   "text": "ジャスミン茶と",
   "start": 16.83,
   "end": 18.05
  },
  {
   "text": "新鮮な牛乳の",
   "start": 18.05,
   "end": 19.17
  },
  {
   "text": "ミルクティー。",
   "start": 19.17,
   "end": 20.42
  },
  {
   "text": "お店で茶葉から",
   "start": 20.42,
   "end": 21.55
  },
  {
   "text": "淹れるので",
   "start": 21.55,
   "end": 22.37
  },
  {
   "text": "香りが",
   "start": 22.37,
   "end": 22.95
  },
  {
   "text": "とても濃いんです。",
   "start": 22.95,
   "end": 24.57
  },
  {
   "text": "お店は世界に",
   "start": 24.57,
   "end": 25.93
  },
  {
   "text": "7000店以上。",
   "start": 25.93,
   "end": 28.15
  },
  {
   "text": "「中国のスタバ」とも",
   "start": 28.15,
   "end": 29.33
  },
  {
   "text": "呼ばれ",
   "start": 29.33,
   "end": 30.0
  },
  {
   "text": "2025年には",
   "start": 30.0,
   "end": 31.38
  },
  {
   "text": "アメリカで上場も",
   "start": 31.38,
   "end": 32.59
  },
  {
   "text": "果たしました。",
   "start": 32.59,
   "end": 33.89
  },
  {
   "text": "今年4月には",
   "start": 33.89,
   "end": 35.31
  },
  {
   "text": "韓国にも上陸。",
   "start": 35.31,
   "end": 37.05
  },
  {
   "text": "2時間以上待ちの",
   "start": 37.05,
   "end": 38.35
  },
  {
   "text": "行列もできました。",
   "start": 38.35,
   "end": 39.96
  },
  {
   "text": "でも日本には",
   "start": 39.96,
   "end": 41.46
  },
  {
   "text": "まだお店がありません。",
   "start": 41.46,
   "end": 43.47
  },
  {
   "text": "出店の予定も",
   "start": 43.47,
   "end": 44.61
  },
  {
   "text": "今のところ",
   "start": 44.61,
   "end": 45.31
  },
  {
   "text": "発表されていません。",
   "start": 45.31,
   "end": 46.93
  },
  {
   "text": "飲みたい人は",
   "start": 46.93,
   "end": 48.05
  },
  {
   "text": "韓国やアジアへの",
   "start": 48.05,
   "end": 49.24
  },
  {
   "text": "旅行のときに",
   "start": 49.24,
   "end": 49.99
  },
  {
   "text": "探してみてください。",
   "start": 49.99,
   "end": 53.13
  }
 ],
