 "subtitles": [
  {
   "text": "ティーバッグは",
   "start": 0.27,
   "end": 1.16
  },
  {
   "text": "絞ってはいけない。",
   "start": 1.16,
   "end": 2.53
  },
  {
   "text": "そんな話を",
   "start": 2.53,
   "end": 2.84
  },
  {
   "text": "聞いたことは",
   "start": 2.84,
   "end": 3.54
  },
  {
   "text": "ありませんか？",
   "start": 3.54,
   "end": 5.01
  },
  {
   "text": "実はこれ",
   "start": 5.01,
   "end": 5.41
  },
  {
   "text": "必ずしも",
   "start": 5.41,
   "end": 6.23
  },
  {
   "text": "正しいわけでは",
   "start": 6.23,
   "end": 7.2
  },
  {
   "text": "ありません。",
   "start": 7.2,
   "end": 8.42
  },
  {
   "text": "そもそも",
   "start": 8.42,
   "end": 8.85
  },
  {
   "text": "ティーバッグを",
   "start": 8.85,
   "end": 9.72
  },
  {
   "text": "絞ってはいけないと",
   "start": 9.72,
   "end": 11.08
  },
  {
   "text": "言われるのは",
   "start": 11.08,
   "end": 12.12
  },
  {
   "text": "紅茶の渋みや",
   "start": 12.12,
   "end": 13.31
  },
  {
   "text": "苦味が強く",
   "start": 13.31,
   "end": 13.96
  },
  {
   "text": "なってしまうからです。",
   "start": 13.96,
   "end": 15.56
  },
  {
   "text": "紅茶には",
   "start": 15.56,
   "end": 15.78
  },
  {
   "text": "タンニンと呼ばれる",
   "start": 15.78,
   "end": 16.98
  },
  {
   "text": "渋みに関係する",
   "start": 16.98,
   "end": 17.84
  },
  {
   "text": "成分が",
   "start": 17.84,
   "end": 18.37
  },
  {
   "text": "含まれています。",
   "start": 18.37,
   "end": 19.87
  },
  {
   "text": "ティーバッグを",
   "start": 19.87,
   "end": 20.52
  },
  {
   "text": "絞ると",
   "start": 20.52,
   "end": 20.97
  },
  {
   "text": "茶葉の周りに",
   "start": 20.97,
   "end": 21.97
  },
  {
   "text": "残っていた",
   "start": 21.97,
   "end": 22.67
  },
  {
   "text": "濃い紅茶が",
   "start": 22.67,
   "end": 23.32
  },
  {
   "text": "押し出され",
   "start": 23.32,
   "end": 24.12
  },
  {
   "text": "渋みや苦味が",
   "start": 24.12,
   "end": 25.02
  },
  {
   "text": "強く",
   "start": 25.02,
   "end": 25.45
  },
  {
   "text": "感じられることが",
   "start": 25.45,
   "end": 26.52
  },
  {
   "text": "あります。",
   "start": 26.52,
   "end": 27.19
  },
  {
   "text": "ただし",
   "start": 27.19,
   "end": 27.8
  },
  {
   "text": "ここで一つ",
   "start": 27.8,
   "end": 28.43
  },
  {
   "text": "誤解があります。",
   "start": 28.43,
   "end": 29.43
  },
  {
   "text": "タンニンは",
   "start": 29.43,
   "end": 30.52
  },
  {
   "text": "ティーバッグを",
   "start": 30.52,
   "end": 31.21
  },
  {
   "text": "絞った瞬間に",
   "start": 31.21,
   "end": 32.22
  },
  {
   "text": "出てくるわけでは",
   "start": 32.22,
   "end": 33.32
  },
  {
   "text": "ありません。",
   "start": 33.32,
   "end": 34.49
  },
  {
   "text": "お湯に浸している間にも",
   "start": 34.49,
   "end": 35.76
  },
  {
   "text": "少しずつ",
   "start": 35.76,
   "end": 36.51
  },
  {
   "text": "抽出されて",
   "start": 36.51,
   "end": 37.12
  },
  {
   "text": "いるのです。",
   "start": 37.12,
   "end": 37.89
  },
  {
   "text": "つまり",
   "start": 37.89,
   "end": 38.5
  },
  {
   "text": "絞ること自体が",
   "start": 38.5,
   "end": 39.41
  },
  {
   "text": "悪いわけでは",
   "start": 39.41,
   "end": 40.32
  },
  {
   "text": "ありません。",
   "start": 40.32,
   "end": 41.69
  },
  {
   "text": "渋みを抑えて",
   "start": 41.69,
   "end": 42.23
  },
  {
   "text": "すっきりとした",
   "start": 42.23,
   "end": 43.43
  },
  {
   "text": "紅茶を",
   "start": 43.43,
   "end": 43.78
  },
  {
   "text": "楽しみたいなら",
   "start": 43.78,
   "end": 44.96
  },
  {
   "text": "絞らずに",
   "start": 44.96,
   "end": 45.59
  },
  {
   "text": "取り出す。",
   "start": 45.59,
   "end": 46.34
  },
  {
   "text": "反対に",
   "start": 46.34,
   "end": 46.99
  },
  {
   "text": "しっかりとした",
   "start": 46.99,
   "end": 47.77
  },
  {
   "text": "渋みや",
   "start": 47.77,
   "end": 48.3
  },
  {
   "text": "濃い味わいが",
   "start": 48.3,
   "end": 49.22
  },
  {
   "text": "好きなら",
   "start": 49.22,
   "end": 50.15
  },
  {
   "text": "軽く絞るのも",
   "start": 50.15,
   "end": 51.37
  },
  {
   "text": "一つの",
   "start": 51.37,
   "end": 51.81
  },
  {
   "text": "楽しみ方です。",
   "start": 51.81,
   "end": 53.08
  },
  {
   "text": "もちろん",
   "start": 53.08,
   "end": 53.39
  },
  {
   "text": "紅茶のコクを",
   "start": 53.39,
   "end": 54.23
  },
  {
   "text": "強くしたいなら",
   "start": 54.23,
   "end": 55.53
  },
  {
   "text": "お湯の量や",
   "start": 55.53,
   "end": 55.9
  },
  {
   "text": "蒸らし時間を",
   "start": 55.9,
   "end": 56.73
  },
  {
   "text": "調整する",
   "start": 56.73,
   "end": 57.43
  },
  {
   "text": "方法もあります。",
   "start": 57.43,
   "end": 58.31
  },
  {
   "text": "結局のところ",
   "start": 58.31,
   "end": 59.28
  },
  {
   "text": "大切なのは",
   "start": 59.28,
   "end": 60.08
  },
  {
   "text": "自分が",
   "start": 60.08,
   "end": 60.82
  },
  {
   "text": "おいしいと思える",
   "start": 60.82,
   "end": 62.05
  },
  {
   "text": "一杯にすること。",
   "start": 62.05,
   "end": 63.53
  },
  {
   "text": "ちなみに皆さんは",
   "start": 63.53,
   "end": 64.23
  },
  {
   "text": "ティーバッグを",
   "start": 64.23,
   "end": 65.24
  },
  {
   "text": "絞る派ですか？",
   "start": 65.24,
   "end": 66.07
  },
  {
   "text": "絞らない派ですか？",
   "start": 66.07,
   "end": 67.17
  },
  {
   "text": "ぜひコメントで",
   "start": 67.17,
   "end": 68.18
  },
  {
   "text": "教えてください！",
