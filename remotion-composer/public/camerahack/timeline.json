   "end": 3.11
  },
  {
   "text": "盗み見られる",
   "start": 3.11,
   "end": 3.77
  },
  {
   "text": "ようになったら",
   "start": 3.77,
   "end": 4.95
  },
  {
   "text": "自分が子どもを",
   "start": 4.95,
   "end": 5.71
  },
  {
   "text": "見守っている間に",
   "start": 5.71,
   "end": 6.97
  },
  {
   "text": "知らない誰かも",
   "start": 6.97,
   "end": 8.13
  },
  {
   "text": "寝室の様子を",
   "start": 8.13,
   "end": 8.89
  },
  {
   "text": "見ているかも",
   "start": 8.89,
   "end": 9.39
  },
  {
   "text": "しれません。",
   "start": 9.39,
   "end": 10.57
  },
  {
   "text": "カメラの",
   "start": 10.57,
   "end": 11.05
  },
  {
   "text": "ハッキングによる",
   "start": 11.05,
   "end": 11.89
  },
  {
   "text": "盗み見は",
   "start": 11.89,
   "end": 12.58
  },
  {
   "text": "以前からある",
   "start": 12.58,
   "end": 13.29
  },
  {
   "text": "危険です。",
   "start": 13.29,
   "end": 14.4
  },
  {
   "text": "そこに今",
   "start": 14.4,
   "end": 15.33
  },
  {
   "text": "新たな懸念が",
   "start": 15.33,
   "end": 16.16
  },
  {
   "text": "出てきています。",
   "start": 16.16,
   "end": 17.54
  },
  {
   "text": "AIの開発会社",
   "start": 17.54,
   "end": 18.9
  },
  {
   "text": "アンソロピックは",
   "start": 18.9,
   "end": 20.17
  },
  {
   "text": "ネットにつながる",
   "start": 20.17,
   "end": 20.85
  },
  {
   "text": "機器の中で",
   "start": 20.85,
   "end": 21.63
  },
  {
   "text": "AIが動き",
   "start": 21.63,
   "end": 22.87
  },
  {
   "text": "自分のコピーを",
   "start": 22.87,
   "end": 23.85
  },
  {
   "text": "別の機器へ",
   "start": 23.85,
   "end": 24.61
  },
  {
   "text": "広げる可能性を",
   "start": 24.61,
   "end": 25.39
  },
  {
   "text": "示しました。",
   "start": 25.39,
   "end": 26.66
  },
  {
   "text": "もし、こうしたAIが",
   "start": 26.66,
   "end": 28.33
  },
  {
   "text": "見守りカメラの",
   "start": 28.33,
   "end": 29.09
  },
  {
   "text": "ハッキングにも",
   "start": 29.09,
   "end": 29.75
  },
  {
   "text": "悪用され",
   "start": 29.75,
   "end": 30.62
  },
  {
   "text": "ほかの機器へ",
   "start": 30.62,
   "end": 31.35
  },
  {
   "text": "コピーが広がったら。",
   "start": 31.35,
   "end": 33.04
  },
  {
   "text": "カメラ一台の",
   "start": 33.04,
   "end": 33.95
  },
  {
   "text": "電源を切っても",
   "start": 33.95,
   "end": 34.95
  },
  {
   "text": "AIは別の機器で",
   "start": 34.95,
   "end": 36.21
  },
  {
   "text": "動き続ける",
   "start": 36.21,
   "end": 37.07
  },
  {
   "text": "おそれがあります。",
   "start": 37.07,
   "end": 38.43
  },
  {
   "text": "家庭でできる",
   "start": 38.43,
   "end": 39.09
  },
  {
   "text": "備えとして",
   "start": 39.09,
   "end": 39.94
  },
  {
   "text": "まず、メーカーの",
   "start": 39.94,
   "end": 41.15
  },
  {
   "text": "公式アプリや",
   "start": 41.15,
   "end": 41.87
  },
  {
   "text": "説明書で",
   "start": 41.87,
   "end": 42.66
  },
  {
   "text": "カメラ本体の更新を",
   "start": 42.66,
   "end": 43.89
  },
  {
   "text": "確認しましょう。",
   "start": 43.89,
   "end": 45.31
  },
  {
   "text": "更新には",
   "start": 45.31,
   "end": 46.17
  },
  {
   "text": "ハッキングに",
   "start": 46.17,
   "end": 46.69
  },
  {
   "text": "使われる弱点を",
   "start": 46.69,
   "end": 47.75
  },
  {
   "text": "直す役割があります。",
   "start": 47.75,
   "end": 49.54
  },
  {
   "text": "スマホのアプリ",
   "start": 49.54,
   "end": 50.33
  },
  {
   "text": "だけでなく",
   "start": 50.33,
   "end": 51.16
  },
  {
   "text": "カメラ本体も",
   "start": 51.16,
   "end": 52.08
  },
  {
   "text": "確認することが",
   "start": 52.08,
   "end": 52.74
  },
  {
   "text": "大切です。",
   "start": 52.74,
   "end": 54.15
  },
  {
   "text": "映像を見るための",
   "start": 54.15,
   "end": 54.93
  },
  {
   "text": "アカウントには",
   "start": 54.93,
   "end": 56.17
  },
  {
   "text": "ほかで使っていない",
   "start": 56.17,
   "end": 57.13
  },
  {
