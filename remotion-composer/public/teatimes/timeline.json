 "subtitles": [
  {
   "text": "ホテルのメニューに",
   "start": 0.34,
   "end": 1.54
  },
  {
   "text": "「アフタヌーンティー」",
   "start": 1.54,
   "end": 2.61
  },
  {
   "text": "と",
   "start": 2.61,
   "end": 2.83
  },
  {
   "text": "「ハイティー」。",
   "start": 2.83,
   "end": 3.89
  },
  {
   "text": "どちらも紅茶と",
   "start": 3.89,
   "end": 5.01
  },
  {
   "text": "ごちそうですが",
   "start": 5.01,
   "end": 6.07
  },
  {
   "text": "何が違うのでしょう？",
   "start": 6.07,
   "end": 7.81
  },
  {
   "text": "いちばんの違いは",
   "start": 7.81,
   "end": 8.99
  },
  {
   "text": "夕食の前か",
   "start": 8.99,
   "end": 10.67
  },
  {
   "text": "夕食そのものか。",
   "start": 10.67,
   "end": 12.58
  },
  {
   "text": "アフタヌーンティーは",
   "start": 12.58,
   "end": 13.89
  },
  {
   "text": "1840年ごろ",
   "start": 13.89,
   "end": 15.41
  },
  {
   "text": "イギリスの公爵夫人が",
   "start": 15.41,
   "end": 16.95
  },
  {
   "text": "始めたとされる",
   "start": 16.95,
   "end": 18.11
  },
  {
   "text": "夕食までのつなぎ。",
   "start": 18.11,
   "end": 20.01
  },
  {
   "text": "時間は",
   "start": 20.01,
   "end": 20.77
  },
  {
   "text": "午後3時から5時ごろ。",
   "start": 20.77,
   "end": 22.79
  },
  {
   "text": "サンドイッチ",
   "start": 22.79,
   "end": 23.71
  },
  {
   "text": "スコーン",
   "start": 23.71,
   "end": 24.32
  },
  {
   "text": "ケーキが主役です。",
   "start": 24.32,
   "end": 26.03
  },
  {
   "text": "3段のスタンドは",
   "start": 26.03,
   "end": 27.28
  },
  {
   "text": "下のサンドイッチから",
   "start": 27.28,
   "end": 28.83
  },
  {
   "text": "上のケーキへ",
   "start": 28.83,
   "end": 29.54
  },
  {
   "text": "食べ進むのが",
   "start": 29.54,
   "end": 30.31
  },
  {
   "text": "一般的です。",
   "start": 30.31,
   "end": 31.73
  },
  {
   "text": "いっぽうハイティーは",
   "start": 31.73,
   "end": 33.38
  },
  {
   "text": "働く人たちが",
   "start": 33.38,
   "end": 34.47
  },
  {
   "text": "仕事のあとにとった",
   "start": 34.47,
   "end": 35.81
  },
  {
   "text": "夕食。",
   "start": 35.81,
   "end": 36.79
  },
  {
   "text": "時間は",
   "start": 36.79,
   "end": 37.42
  },
  {
   "text": "夕方5時から7時ごろ。",
   "start": 37.42,
   "end": 39.99
  },
  {
   "text": "肉のパイなど",
   "start": 39.99,
   "end": 41.05
  },
  {
   "text": "しっかりした料理が",
   "start": 41.05,
   "end": 41.97
  },
  {
   "text": "並びました。",
   "start": 41.97,
   "end": 43.05
  },
  {
   "text": "食べる場所も",
   "start": 43.05,
   "end": 44.02
  },
  {
   "text": "アフタヌーンティーは",
   "start": 44.02,
   "end": 45.13
  },
  {
   "text": "ソファの前の",
   "start": 45.13,
   "end": 46.05
  },
  {
   "text": "低いテーブル",
   "start": 46.05,
   "end": 47.27
  },
  {
   "text": "ハイティーは",
   "start": 47.27,
   "end": 48.05
  },
  {
   "text": "高い食卓です。",
   "start": 48.05,
   "end": 49.62
  },
  {
   "text": "ただ",
   "start": 49.62,
   "end": 50.19
  },
  {
   "text": "海外のホテルでは豪華な",
   "start": 50.19,
   "end": 51.89
  },
  {
   "text": "アフタヌーンティーを",
   "start": 51.89,
   "end": 52.91
  },
  {
   "text": "「ハイティー」と",
   "start": 52.91,
   "end": 53.61
  },
  {
   "text": "呼ぶことも",
   "start": 53.61,
   "end": 54.03
  },
  {
   "text": "あるそうです。",
   "start": 54.03,
   "end": 55.27
  },
  {
   "text": "迷ったら",
   "start": 55.27,
   "end": 55.97
  },
  {
   "text": "名前より",
   "start": 55.97,
   "end": 56.69
  },
  {
   "text": "時間とお料理を",
   "start": 56.69,
   "end": 57.67
  },
  {
   "text": "見てみましょう。",
   "start": 57.67,
   "end": 58.85
  },
  {
   "text": "スコーンで",
   "start": 58.85,
   "end": 59.39
  },
  {
   "text": "夕食を待つか",
   "start": 59.39,
   "end": 60.48
  },
  {
   "text": "お肉と紅茶で",
   "start": 60.48,
   "end": 61.51
  },
  {
   "text": "夕食にするか。",
   "start": 61.51,
   "end": 62.72
  },
  {
   "text": "今日のあなたは",
   "start": 62.72,
   "end": 63.73
  },
  {
   "text": "どちらの",
   "start": 63.73,
   "end": 64.09
  },
  {
   "text": "ティータイムですか？",
   "start": 64.09,
   "end": 67.09
  }
 ],
 "mouth": []
}