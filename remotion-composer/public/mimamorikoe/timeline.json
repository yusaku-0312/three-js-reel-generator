 "subtitles": [
  {
   "text": "もしも、お子さんが",
   "start": 0.26,
   "end": 1.49
  },
  {
   "text": "留守番中、",
   "start": 1.49,
   "end": 2.42
  },
  {
   "text": "見守りカメラから",
   "start": 2.42,
   "end": 3.37
  },
  {
   "text": "ママの声で",
   "start": 3.37,
   "end": 4.53
  },
  {
   "text": "「玄関の鍵を開けて」と",
   "start": 4.53,
   "end": 5.91
  },
  {
   "text": "聞こえてきたら？",
   "start": 5.91,
   "end": 7.49
  },
  {
   "text": "見守りカメラの",
   "start": 7.49,
   "end": 8.21
  },
  {
   "text": "中には、",
   "start": 8.21,
   "end": 9.09
  },
  {
   "text": "外出先から",
   "start": 9.09,
   "end": 9.81
  },
  {
   "text": "スマホを使って、",
   "start": 9.81,
   "end": 10.85
  },
  {
   "text": "子どもに",
   "start": 10.85,
   "end": 11.31
  },
  {
   "text": "話しかけられる",
   "start": 11.31,
   "end": 11.99
  },
  {
   "text": "ものがあります。",
   "start": 11.99,
   "end": 13.27
  },
  {
   "text": "でも、そのカメラの",
   "start": 13.27,
   "end": 14.55
  },
  {
   "text": "アカウントが",
   "start": 14.55,
   "end": 15.11
  },
  {
   "text": "ハッキングされ、",
   "start": 15.11,
   "end": 16.04
  },
  {
   "text": "話しかける機能を",
   "start": 16.04,
   "end": 17.07
  },
  {
   "text": "勝手に使われたら、",
   "start": 17.07,
   "end": 18.39
  },
  {
   "text": "知らない人も",
   "start": 18.39,
   "end": 19.09
  },
  {
   "text": "カメラから",
   "start": 19.09,
   "end": 19.73
  },
  {
   "text": "声を流せて",
   "start": 19.73,
   "end": 20.31
  },
  {
   "text": "しまいます。",
   "start": 20.31,
   "end": 21.59
  },
  {
   "text": "さらに、",
   "start": 21.59,
   "end": 22.27
  },
  {
   "text": "AIでママの声を",
   "start": 22.27,
   "end": 23.61
  },
  {
   "text": "まねされると、",
   "start": 23.61,
   "end": 24.37
  },
  {
   "text": "子どもには",
   "start": 24.37,
   "end": 25.15
  },
  {
   "text": "本当にママが",
   "start": 25.15,
   "end": 25.85
  },
  {
   "text": "話しかけているように",
   "start": 25.85,
   "end": 26.74
  },
  {
   "text": "聞こえるかも",
   "start": 26.74,
   "end": 27.31
  },
  {
   "text": "しれません。",
   "start": 27.31,
   "end": 28.63
  },
  {
   "text": "SNSに載せた",
   "start": 28.63,
   "end": 29.63
  },
  {
   "text": "動画の声が、",
   "start": 29.63,
   "end": 30.51
  },
  {
   "text": "その材料にされる",
   "start": 30.51,
   "end": 31.38
  },
  {
   "text": "可能性もあります。",
   "start": 31.38,
   "end": 33.27
  },
  {
   "text": "たとえば、",
   "start": 33.27,
   "end": 33.86
  },
  {
   "text": "カメラから",
   "start": 33.86,
   "end": 34.43
  },
  {
   "text": "ママの声で",
   "start": 34.43,
   "end": 35.44
  },
  {
   "text": "「お友達が",
   "start": 35.44,
   "end": 36.07
  },
  {
   "text": "迎えに来たから、",
   "start": 36.07,
   "end": 37.05
  },
  {
   "text": "玄関を開けて」と",
   "start": 37.05,
   "end": 38.15
  },
  {
   "text": "言われる。",
   "start": 38.15,
   "end": 39.17
  },
  {
   "text": "聞き慣れた",
   "start": 39.17,
   "end": 39.69
  },
  {
   "text": "声なら、",
   "start": 39.69,
   "end": 40.35
  },
  {
   "text": "子どもは",
   "start": 40.35,
   "end": 40.85
  },
  {
   "text": "ママを信じて、",
   "start": 40.85,
   "end": 41.81
  },
  {
   "text": "鍵を開けて",
   "start": 41.81,
   "end": 42.39
  },
  {
   "text": "しまうかも",
   "start": 42.39,
   "end": 42.83
  },
  {
   "text": "しれません。",
   "start": 42.83,
   "end": 43.87
  },
  {
   "text": "だから、",
   "start": 43.87,
   "end": 44.63
  },
  {
   "text": "カメラから",
   "start": 44.63,
   "end": 45.27
  },
  {
   "text": "パパやママの声で",
   "start": 45.27,
   "end": 46.31
  },
  {
   "text": "お願いをされても、",
   "start": 46.31,
   "end": 47.59
  },
  {
   "text": "鍵を開ける前に、",
   "start": 47.59,
   "end": 48.85
  },
  {
   "text": "自分の電話から",
   "start": 48.85,
   "end": 49.74
  },
  {
   "text": "いつもの番号に",
   "start": 49.74,
   "end": 50.54
  },
  {
   "text": "かけて",
   "start": 50.54,
   "end": 51.0
  },
  {
   "text": "確認することを、",
   "start": 51.0,
   "end": 51.99
  },
  {
   "text": "親子で",
   "start": 51.99,
   "end": 52.52
  },
  {
   "text": "約束しておきましょう。",
   "start": 52.52,
   "end": 54.21
  },
  {
   "text": "電話がつながらず、",
   "start": 54.21,
   "end": 55.43
  },
  {
   "text": "確認できない",
   "start": 55.43,
   "end": 56.31
  },
  {
   "text": "ときは、",
   "start": 56.31,
   "end": 56.61
  },
  {
   "text": "鍵を開けない。",
   "start": 56.61,
   "end": 58.03
  },
  {
   "text": "子どもが",
   "start": 58.03,
   "end": 58.49
  },
  {
   "text": "一人で",
   "start": 58.49,
   "end": 58.93
  },
  {
   "text": "電話できない",
   "start": 58.93,
   "end": 59.51
  },
  {
   "text": "場合も、",
   "start": 59.51,
   "end": 60.21
  },
  {
   "text": "どうやって",
   "start": 60.21,
   "end": 60.58
  },
  {
   "text": "助けを求めるか、",
   "start": 60.58,
   "end": 61.77
  },
  {
   "text": "事前に",
   "start": 61.77,
   "end": 62.09
  },
  {
   "text": "決めておいてください。",
   "start": 62.09,
   "end": 63.63
  },
  {
   "text": "そして",
   "start": 63.63,
   "end": 64.07
  },
  {
   "text": "パパ・ママは、",
   "start": 64.07,
   "end": 65.0
  },
  {
   "text": "カメラ本体や",
   "start": 65.0,
   "end": 66.11
  },
  {
   "text": "専用アプリの",
   "start": 66.11,
   "end": 66.83
  },
  {
   "text": "更新を確認。",
   "start": 66.83,
   "end": 68.22
  },
  {
   "text": "アカウントには、",
   "start": 68.22,
   "end": 69.4
  },
  {
   "text": "ほかで使っていない",
   "start": 69.4,
   "end": 69.97
  },
  {
   "text": "パスワードを",
   "start": 69.97,
   "end": 70.57
  },
  {
   "text": "設定し、",
   "start": 70.57,
   "end": 71.44
  },
  {
   "text": "確認コードを",
   "start": 71.44,
   "end": 72.13
  },
  {
   "text": "追加できる",
   "start": 72.13,
   "end": 72.63
  },
  {
   "text": "場合は、",
   "start": 72.63,
   "end": 73.1
  },
  {
   "text": "その設定も",
   "start": 73.1,
   "end": 73.85
  },
  {
   "text": "有効にしましょう。",
   "start": 73.85,
   "end": 75.24
  },
  {
   "text": "子どもを守る",
   "start": 75.24,
   "end": 75.98
  },
  {
   "text": "AIリテラシーを",
   "start": 75.98,
   "end": 76.99
  },
  {
   "text": "知りたいパパ・ママは、",
   "start": 76.99,
   "end": 78.1
  },
  {
   "text": "プロフィールから。",
   "start": 78.1,
   "end": 79.37
  },
  {
   "text": "他のリールも",
   "start": 79.37,
   "end": 79.99
  },
  {
   "text": "チェックして、",
   "start": 79.99,
   "end": 80.72
  },
  {
   "text": "フォローもぜひ！",
   "start": 80.72,
   "end": 83.73
  }
