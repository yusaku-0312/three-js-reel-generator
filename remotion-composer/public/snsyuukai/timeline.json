 "subtitles": [
  {
   "text": "子どもの成長や",
   "start": 0.37,
   "end": 1.45
  },
  {
   "text": "家族のお出かけを",
   "start": 1.45,
   "end": 2.63
  },
  {
   "text": "SNSに",
   "start": 2.63,
   "end": 3.19
  },
  {
   "text": "残している",
   "start": 3.19,
   "end": 3.77
  },
  {
   "text": "パパ・ママも",
   "start": 3.77,
   "end": 4.35
  },
  {
   "text": "いますよね。",
   "start": 4.35,
   "end": 5.33
  },
  {
   "text": "でも、誰でも見られる",
   "start": 5.33,
   "end": 6.87
  },
  {
   "text": "投稿は",
   "start": 6.87,
   "end": 7.61
  },
  {
   "text": "知らない人にも",
   "start": 7.61,
   "end": 8.41
  },
  {
   "text": "保存される",
   "start": 8.41,
   "end": 8.88
  },
  {
   "text": "ことがあります。",
   "start": 8.88,
   "end": 10.09
  },
  {
   "text": "そこに写った顔や",
   "start": 10.09,
   "end": 11.51
  },
  {
   "text": "動画に入った声を",
   "start": 11.51,
   "end": 12.46
  },
  {
   "text": "AIでまねされると",
   "start": 12.46,
   "end": 14.05
  },
  {
   "text": "子どもに",
   "start": 14.05,
   "end": 14.51
  },
  {
   "text": "なりすますために",
   "start": 14.51,
   "end": 15.12
  },
  {
   "text": "使われる",
   "start": 15.12,
   "end": 15.77
  },
  {
   "text": "おそれがあるんです。",
   "start": 15.77,
   "end": 17.13
  },
  {
   "text": "たとえば、",
   "start": 17.13,
   "end": 17.75
  },
  {
   "text": "子どもは無事なのに",
   "start": 17.75,
   "end": 19.07
  },
  {
   "text": "その子が",
   "start": 19.07,
   "end": 19.61
  },
  {
   "text": "誘拐されたように",
   "start": 19.61,
   "end": 20.43
  },
  {
   "text": "見える",
   "start": 20.43,
   "end": 20.89
  },
  {
   "text": "偽の写真や動画が",
   "start": 20.89,
   "end": 22.03
  },
  {
   "text": "届いたとします。",
   "start": 22.03,
   "end": 23.29
  },
  {
   "text": "その子の顔を使った",
   "start": 23.29,
   "end": 24.51
  },
  {
   "text": "ディープフェイクに",
   "start": 24.51,
   "end": 25.51
  },
  {
   "text": "本人そっくりの声で",
   "start": 25.51,
   "end": 27.11
  },
  {
   "text": "「ママ、助けて」と",
   "start": 27.11,
   "end": 28.51
  },
  {
   "text": "話す偽の音声まで",
   "start": 28.51,
   "end": 29.66
  },
  {
   "text": "加われば",
   "start": 29.66,
   "end": 30.71
  },
  {
   "text": "本当に",
   "start": 30.71,
   "end": 31.15
  },
  {
   "text": "誘拐されたと",
   "start": 31.15,
   "end": 31.79
  },
  {
   "text": "思ってしまう",
   "start": 31.79,
   "end": 32.26
  },
  {
   "text": "かもしれません。",
   "start": 32.26,
   "end": 33.75
  },
  {
   "text": "実際に",
   "start": 33.75,
   "end": 34.65
  },
  {
   "text": "SNSの写真を",
   "start": 34.65,
   "end": 35.6
  },
  {
   "text": "加工した",
   "start": 35.6,
   "end": 36.39
  },
  {
   "text": "偽の誘拐写真や",
   "start": 36.39,
   "end": 37.97
  },
  {
   "text": "家族の声をまねた",
   "start": 37.97,
   "end": 38.99
  },
  {
   "text": "音声で",
   "start": 38.99,
   "end": 39.58
  },
  {
   "text": "お金を要求する",
   "start": 39.58,
   "end": 40.63
  },
  {
   "text": "詐欺への",
   "start": 40.63,
   "end": 41.15
  },
  {
   "text": "注意喚起も",
   "start": 41.15,
   "end": 41.7
  },
  {
   "text": "出ています。",
   "start": 41.7,
   "end": 42.87
  },
  {
   "text": "しかも、",
   "start": 42.87,
   "end": 43.69
  },
  {
   "text": "投稿から",
   "start": 43.69,
   "end": 44.15
  },
  {
   "text": "知られるのは",
   "start": 44.15,
   "end": 44.99
  },
  {
   "text": "顔や声だけとは",
   "start": 44.99,
   "end": 46.03
  },
  {
   "text": "限りません。",
   "start": 46.03,
   "end": 47.33
  },
  {
   "text": "写真に写った",
   "start": 47.33,
   "end": 48.11
  },
  {
   "text": "学校名や",
   "start": 48.11,
   "end": 48.99
  },
  {
   "text": "自宅の外観",
   "start": 48.99,
   "end": 50.19
  },
  {
   "text": "背景の看板",
   "start": 50.19,
   "end": 51.56
  },
  {
   "text": "投稿文に書いた",
   "start": 51.56,
   "end": 52.45
  },
  {
   "text": "場所も",
   "start": 52.45,
   "end": 53.19
  },
  {
   "text": "自宅や",
   "start": 53.19,
   "end": 53.72
  },
  {
   "text": "通う学校を",
   "start": 53.72,
   "end": 54.51
  },
  {
   "text": "調べる",
   "start": 54.51,
   "end": 54.81
  },
  {
   "text": "手掛かりになります。",
   "start": 54.81,
   "end": 56.59
  },
  {
   "text": "住所を書いて",
   "start": 56.59,
   "end": 57.09
  },
  {
   "text": "いなくても",
   "start": 57.09,
   "end": 58.03
  },
  {
   "text": "悪用する人が",
   "start": 58.03,
   "end": 58.97
  },
  {
   "text": "別々の投稿を",
   "start": 58.97,
   "end": 59.75
  },
  {
   "text": "つなげて見れば",
   "start": 59.75,
   "end": 60.82
  },
  {
   "text": "その子が",
   "start": 60.82,
   "end": 61.39
  },
  {
   "text": "どこで生活して",
   "start": 61.39,
   "end": 62.21
  },
  {
   "text": "いるかを",
   "start": 62.21,
   "end": 62.71
  },
  {
   "text": "推測できてしまう",
   "start": 62.71,
   "end": 63.48
  },
  {
   "text": "ことがあるんです。",
   "start": 63.48,
   "end": 64.97
  },
  {
   "text": "こうしたリスクを",
   "start": 64.97,
   "end": 65.769
  },
  {
   "text": "減らすには",
   "start": 65.769,
   "end": 66.64
  },
  {
   "text": "子どもの写真や",
   "start": 66.64,
   "end": 67.53
  },
  {
   "text": "動画を",
   "start": 67.53,
   "end": 68.15
  },
  {
   "text": "SNSに",
   "start": 68.15,
   "end": 68.87
  },
  {
   "text": "投稿しないことが",
   "start": 68.87,
   "end": 69.97
  },
  {
   "text": "一番確実です。",
   "start": 69.97,
   "end": 71.53
  },
  {
   "text": "公開範囲を",
   "start": 71.53,
   "end": 72.35
  },
  {
   "text": "絞った投稿も",
   "start": 72.35,
   "end": 73.44
  },
  {
   "text": "保存や転載で",
   "start": 73.44,
   "end": 74.45
  },
  {
   "text": "外に出る",
   "start": 74.45,
   "end": 74.87
  },
  {
   "text": "可能性は",
   "start": 74.87,
   "end": 75.47
  },
  {
   "text": "残ります。",
   "start": 75.47,
   "end": 76.5
  },
  {
   "text": "そのため",
   "start": 76.5,
   "end": 77.27
  },
  {
   "text": "すでに載せた",
   "start": 77.27,
   "end": 78.03
  },
  {
   "text": "写真や動画も",
   "start": 78.03,
   "end": 79.02
  },
  {
   "text": "公開を続ける",
   "start": 79.02,
   "end": 79.95
  },
  {
   "text": "必要があるか",
   "start": 79.95,
   "end": 80.94
  },
  {
   "text": "一度",
   "start": 80.94,
   "end": 81.21
  },
  {
   "text": "見直してみてください。",
   "start": 81.21,
   "end": 82.79
  },
  {
   "text": "子どもを守る",
   "start": 82.79,
   "end": 83.63
  },
  {
   "text": "AIリテラシーを",
   "start": 83.63,
   "end": 84.55
  },
  {
   "text": "知りたいパパ・ママは",
   "start": 84.55,
   "end": 85.62
  },
  {
   "text": "プロフィールから。",
   "start": 85.62,
   "end": 86.82
  },
  {
   "text": "他のリールも",
   "start": 86.82,
   "end": 87.43
  },
  {
   "text": "チェックして",
   "start": 87.43,
   "end": 88.18
  },
  {
   "text": "フォローもぜひ！",
   "start": 88.18,
   "end": 91.23
  }
 ],
