 "subtitles": [
  {
   "text": "ミルクティーとチャイ",
   "start": 0.37,
   "end": 2.46
  },
  {
   "text": "いちばんの違いは",
   "start": 2.46,
   "end": 3.25
  },
  {
   "text": "スパイスでは",
   "start": 3.25,
   "end": 3.81
  },
  {
   "text": "ありません。",
   "start": 3.81,
   "end": 4.9
  },
  {
   "text": "インドでは",
   "start": 4.9,
   "end": 5.69
  },
  {
   "text": "スパイスの入らない",
   "start": 5.69,
   "end": 6.68
  },
  {
   "text": "チャイも",
   "start": 6.68,
   "end": 7.53
  },
  {
   "text": "ふつうに",
   "start": 7.53,
   "end": 7.61
  },
  {
   "text": "飲まれています。",
   "start": 7.61,
   "end": 8.99
  },
  {
   "text": "違いは",
   "start": 8.99,
   "end": 9.77
  },
  {
   "text": "ミルクを入れる",
   "start": 9.77,
   "end": 10.67
  },
  {
   "text": "順番です。",
   "start": 10.67,
   "end": 11.71
  },
  {
   "text": "ミルクティーは",
   "start": 11.71,
   "end": 12.66
  },
  {
   "text": "お湯で淹れた紅茶に",
   "start": 12.66,
   "end": 14.18
  },
  {
   "text": "あとから",
   "start": 14.18,
   "end": 14.47
  },
  {
   "text": "ミルクを足します。",
   "start": 14.47,
   "end": 15.8
  },
  {
   "text": "チャイは",
   "start": 15.8,
   "end": 17.19
  },
  {
   "text": "茶葉をミルクと一緒に",
   "start": 17.19,
   "end": 18.49
  },
  {
   "text": "鍋で",
   "start": 18.49,
   "end": 19.89
  },
  {
   "text": "ぐつぐつ煮出します。",
   "start": 19.89,
   "end": 20.79
  },
  {
   "text": "だから",
   "start": 20.79,
   "end": 21.47
  },
  {
   "text": "ミルクに負けない",
   "start": 21.47,
   "end": 22.71
  },
  {
   "text": "濃い味になるんです。",
   "start": 22.71,
   "end": 24.08
  },
  {
   "text": "インドの屋台で",
   "start": 24.08,
   "end": 24.99
  },
  {
   "text": "よく使われるのは",
   "start": 24.99,
   "end": 26.84
  },
  {
   "text": "CTCという",
   "start": 26.84,
   "end": 27.69
  },
  {
   "text": "粒のように",
   "start": 27.69,
   "end": 28.01
  },
  {
   "text": "細かい茶葉。",
   "start": 28.01,
   "end": 29.53
  },
  {
   "text": "短い時間で",
   "start": 29.53,
   "end": 30.61
  },
  {
   "text": "しっかり濃く出る",
   "start": 30.61,
   "end": 31.72
  },
  {
   "text": "茶葉です。",
   "start": 31.72,
   "end": 33.09
  },
  {
   "text": "煮出して飲むように",
   "start": 33.09,
   "end": 33.71
  },
  {
   "text": "なったのは",
   "start": 33.71,
   "end": 34.49
  },
  {
   "text": "イギリスの",
   "start": 34.49,
   "end": 35.57
  },
  {
   "text": "植民地だったころ。",
   "start": 35.57,
   "end": 37.43
  },
  {
   "text": "質のいい茶葉は",
   "start": 37.43,
   "end": 38.67
  },
  {
   "text": "輸出に回され",
   "start": 38.67,
   "end": 39.66
  },
  {
   "text": "残った茶葉を",
   "start": 39.66,
   "end": 40.73
  },
  {
   "text": "おいしく飲む",
   "start": 40.73,
   "end": 41.19
  },
  {
   "text": "工夫だったと",
   "start": 41.19,
   "end": 41.73
  },
  {
   "text": "言われます。",
   "start": 41.73,
   "end": 43.43
  },
  {
   "text": "しょうがや",
   "start": 43.43,
   "end": 43.81
  },
  {
   "text": "カルダモンを",
   "start": 43.81,
   "end": 44.35
  },
  {
   "text": "入れたものは",
   "start": 44.35,
   "end": 45.21
  },
  {
   "text": "「マサラチャイ」。",
   "start": 45.21,
   "end": 46.53
  },
  {
   "text": "マサラは",
   "start": 46.53,
   "end": 47.23
  },
  {
   "text": "スパイスを",
   "start": 47.23,
   "end": 47.93
  },
  {
   "text": "混ぜたもの",
   "start": 47.93,
   "end": 48.65
  },
  {
   "text": "という意味です。",
   "start": 48.65,
   "end": 49.97
  },
  {
   "text": "そしてチャイは",
   "start": 49.97,
   "end": 51.33
  },
  {
   "text": "ヒンディー語で",
   "start": 51.33,
   "end": 52.23
  },
  {
   "text": "ただの「お茶」。",
   "start": 52.23,
   "end": 53.87
  },
  {
   "text": "中国の「茶（チャ）」が",
   "start": 53.87,
   "end": 55.39
  },
  {
   "text": "ペルシャ語を通って",
   "start": 55.39,
   "end": 56.55
  },
  {
   "text": "インドに伝わった",
   "start": 56.55,
   "end": 57.44
  },
  {
   "text": "言葉なんです。",
   "start": 57.44,
   "end": 58.71
  },
  {
   "text": "日本語の「ちゃ」と",
   "start": 58.71,
   "end": 60.49
  },
  {
   "text": "もとは同じです。",
   "start": 60.49,
   "end": 62.12
  },
  {
   "text": "あとからミルクを",
   "start": 62.12,
   "end": 62.97
  },
  {
   "text": "足すか",
   "start": 62.97,
   "end": 63.83
  },
  {
   "text": "最初からミルクで",
   "start": 63.83,
   "end": 64.91
  },
  {
   "text": "煮るか。",
   "start": 64.91,
   "end": 65.77
  },
  {
   "text": "同じ「茶」から",
   "start": 65.77,
   "end": 66.87
  },
  {
   "text": "生まれた",
   "start": 66.87,
   "end": 67.46
  },
  {
   "text": "ふたつの飲み方",
   "start": 67.46,
   "end": 68.31
  },
  {
   "text": "なんです。",
   "start": 68.31,
   "end": 71.01
  }
 ],
 "mouth": []
}