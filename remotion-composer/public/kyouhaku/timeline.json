 "subtitles": [
  {
   "text": "お子さんが",
   "start": 0.27,
   "end": 1.1
  },
  {
   "text": "撮った覚えのない",
   "start": 1.1,
   "end": 2.05
  },
  {
   "text": "写真で",
   "start": 2.05,
   "end": 2.51
  },
  {
   "text": "脅されることが",
   "start": 2.51,
   "end": 3.23
  },
  {
   "text": "あります。",
   "start": 3.23,
   "end": 4.24
  },
  {
   "text": "たとえば",
   "start": 4.24,
   "end": 5.13
  },
  {
   "text": "知らないアカウントから",
   "start": 5.13,
   "end": 6.32
  },
  {
   "text": "お子さんの顔が",
   "start": 6.32,
   "end": 7.2
  },
  {
   "text": "写った",
   "start": 7.2,
   "end": 7.87
  },
  {
   "text": "人には",
   "start": 7.87,
   "end": 8.27
  },
  {
   "text": "見せられないような",
   "start": 8.27,
   "end": 9.07
  },
  {
   "text": "画像が",
   "start": 9.07,
   "end": 9.5
  },
  {
   "text": "届きます。",
   "start": 9.5,
   "end": 10.55
  },
  {
   "text": "「お金を払わないと",
   "start": 10.55,
   "end": 11.99
  },
  {
   "text": "友達に送る」",
   "start": 11.99,
   "end": 13.33
  },
  {
   "text": "本人は",
   "start": 13.33,
   "end": 14.11
  },
  {
   "text": "そんな写真を",
   "start": 14.11,
   "end": 14.73
  },
  {
   "text": "撮っていません。",
   "start": 14.73,
   "end": 16.03
  },
  {
   "text": "SNSに載せていた",
   "start": 16.03,
   "end": 17.17
  },
  {
   "text": "普通の写真を",
   "start": 17.17,
   "end": 18.3
  },
  {
   "text": "AIで",
   "start": 18.3,
   "end": 18.87
  },
  {
   "text": "加工されたもの",
   "start": 18.87,
   "end": 19.57
  },
  {
   "text": "だったんです。",
   "start": 19.57,
   "end": 20.61
  },
  {
   "text": "それでも",
   "start": 20.61,
   "end": 21.49
  },
  {
   "text": "「偽物だと",
   "start": 21.49,
   "end": 22.23
  },
  {
   "text": "信じてもらえ",
   "start": 22.23,
   "end": 22.83
  },
  {
   "text": "なかったら」と",
   "start": 22.83,
   "end": 23.77
  },
  {
   "text": "怖くなり",
   "start": 23.77,
   "end": 24.85
  },
  {
   "text": "誰にも",
   "start": 24.85,
   "end": 25.25
  },
  {
   "text": "相談できなく",
   "start": 25.25,
   "end": 25.83
  },
  {
   "text": "なるかもしれません。",
   "start": 25.83,
   "end": 27.26
  },
  {
   "text": "パパさん・ママさん。",
   "start": 27.26,
   "end": 28.94
  },
  {
   "text": "こうしたとき",
   "start": 28.94,
   "end": 29.91
  },
  {
   "text": "お子さんが",
   "start": 29.91,
   "end": 30.52
  },
  {
   "text": "一人で",
   "start": 30.52,
   "end": 30.96
  },
  {
   "text": "解決しようとしない",
   "start": 30.96,
   "end": 31.78
  },
  {
   "text": "ために",
   "start": 31.78,
   "end": 32.3
  },
  {
   "text": "伝えておきたいことが",
   "start": 32.3,
   "end": 33.25
  },
  {
   "text": "あります。",
   "start": 33.25,
   "end": 34.33
  },
  {
   "text": "まず",
   "start": 34.33,
   "end": 35.09
  },
  {
   "text": "お金や",
   "start": 35.09,
   "end": 35.66
  },
  {
   "text": "新しい写真を",
   "start": 35.66,
   "end": 36.45
  },
  {
   "text": "送っても",
   "start": 36.45,
   "end": 37.27
  },
  {
   "text": "要求が終わる",
   "start": 37.27,
   "end": 37.97
  },
  {
   "text": "保証はありません。",
   "start": 37.97,
   "end": 39.46
  },
  {
   "text": "相手の要求に",
   "start": 39.46,
   "end": 40.39
  },
  {
   "text": "応じる前に",
   "start": 40.39,
   "end": 41.27
  },
  {
   "text": "必ず",
   "start": 41.27,
   "end": 41.73
  },
  {
   "text": "大人に知らせること。",
   "start": 41.73,
   "end": 43.57
  },
  {
   "text": "「親に言ったら",
   "start": 43.57,
   "end": 44.23
  },
  {
   "text": "怒られる」と",
   "start": 44.23,
   "end": 45.17
  },
  {
   "text": "思わせないよう",
   "start": 45.17,
   "end": 46.19
  },
  {
   "text": "普段から",
   "start": 46.19,
   "end": 47.01
  },
  {
   "text": "「何か",
   "start": 47.01,
   "end": 47.23
  },
  {
   "text": "送ってしまっていても",
   "start": 47.23,
   "end": 48.41
  },
  {
   "text": "相談していいよ」と",
   "start": 48.41,
   "end": 49.35
  },
  {
   "text": "伝えてください。",
   "start": 49.35,
   "end": 50.91
  },
  {
   "text": "相談されたら",
   "start": 50.91,
   "end": 51.85
  },
  {
   "text": "最初は",
   "start": 51.85,
   "end": 52.52
  },
  {
   "text": "「話してくれて",
   "start": 52.52,
   "end": 53.09
  },
  {
   "text": "ありがとう。",
   "start": 53.09,
   "end": 53.87
  },
  {
   "text": "一緒に対応しよう」で",
   "start": 53.87,
   "end": 55.19
  },
  {
   "text": "大丈夫です。",
   "start": 55.19,
   "end": 56.35
  },
  {
   "text": "本物か偽物かに",
   "start": 56.35,
   "end": 57.52
  },
  {
   "text": "かかわらず",
   "start": 57.52,
   "end": 58.38
  },
  {
   "text": "脅されている",
   "start": 58.38,
   "end": 59.01
  },
  {
   "text": "お子さんを",
   "start": 59.01,
   "end": 59.61
  },
  {
   "text": "守る必要が",
   "start": 59.61,
   "end": 60.27
  },
  {
   "text": "あります。",
   "start": 60.27,
   "end": 61.19
  },
  {
   "text": "相手とのやり取りは",
   "start": 61.19,
   "end": 62.23
  },
  {
   "text": "続けず",
   "start": 62.23,
   "end": 62.97
  },
  {
   "text": "脅しのメッセージや",
   "start": 62.97,
   "end": 64.02
  },
  {
   "text": "アカウント情報は",
   "start": 64.02,
   "end": 64.91
  },
  {
   "text": "消さずに残し",
   "start": 64.91,
   "end": 66.27
  },
  {
   "text": "警察や",
   "start": 66.27,
   "end": 66.75
  },
  {
   "text": "利用サービスへ",
   "start": 66.75,
   "end": 67.55
  },
  {
   "text": "相談しましょう。",
   "start": 67.55,
   "end": 68.75
  },
  {
   "text": "真偽を",
   "start": 68.75,
   "end": 69.23
  },
  {
   "text": "確かめようと",
   "start": 69.23,
   "end": 70.07
  },
  {
   "text": "問題の画像を",
   "start": 70.07,
   "end": 70.88
  },
  {
   "text": "友達へ転送することも",
   "start": 70.88,
   "end": 72.33
  },
  {
   "text": "避けてください。",
   "start": 72.33,
   "end": 73.61
  },
  {
   "text": "そして",
   "start": 73.61,
   "end": 74.47
  },
  {
   "text": "親子で",
   "start": 74.47,
   "end": 75.11
  },
  {
   "text": "写真の公開範囲も",
   "start": 75.11,
   "end": 76.31
  },
  {
   "text": "確認して",
   "start": 76.31,
   "end": 76.67
  },
  {
   "text": "おきましょう。",
   "start": 76.67,
   "end": 77.71
  },
  {
   "text": "見られる相手を",
   "start": 77.71,
   "end": 78.47
  },
  {
   "text": "絞ることは",
   "start": 78.47,
   "end": 79.41
  },
  {
   "text": "写真が",
   "start": 79.41,
   "end": 79.83
  },
  {
   "text": "知らない人の",
   "start": 79.83,
   "end": 80.37
  },
  {
   "text": "手に渡る機会を",
   "start": 80.37,
   "end": 81.31
  },
  {
   "text": "減らすことに",
   "start": 81.31,
   "end": 81.86
  },
  {
   "text": "つながります。",
   "start": 81.86,
   "end": 83.04
  },
  {
   "text": "今日",
   "start": 83.04,
   "end": 83.5
  },
  {
   "text": "お子さんに",
   "start": 83.5,
   "end": 84.02
  },
  {
   "text": "一言",
   "start": 84.02,
   "end": 84.59
  },
  {
   "text": "伝えてみてください。",
   "start": 84.59,
   "end": 86.15
  },
  {
   "text": "「脅されたら",
   "start": 86.15,
   "end": 87.17
  },
  {
   "text": "一人で",
   "start": 87.17,
   "end": 87.57
  },
  {
   "text": "何とかしなくていい。",
   "start": 87.57,
   "end": 89.11
  },
  {
   "text": "何があっても",
   "start": 89.11,
   "end": 89.97
  },
  {
   "text": "一緒に考えるよ」",
   "start": 89.97,
   "end": 93.05
  }
 ],
