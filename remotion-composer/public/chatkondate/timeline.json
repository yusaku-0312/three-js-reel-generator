 "subtitles": [
  {
   "text": "冷蔵庫の中を撮って",
   "start": 0.45,
   "end": 1.52
  },
  {
   "text": "ChatGPTに送ると",
   "start": 1.52,
   "end": 3.43
  },
  {
   "text": "今ある食材から",
   "start": 3.43,
   "end": 4.47
  },
  {
   "text": "夕飯の候補を",
   "start": 4.47,
   "end": 5.25
  },
  {
   "text": "考えてもらえます。",
   "start": 5.25,
   "end": 6.89
  },
  {
   "text": "写真を添付して",
   "start": 6.89,
   "end": 7.9
  },
  {
   "text": "こんなふうに",
   "start": 7.9,
   "end": 8.41
  },
  {
   "text": "頼みます。",
   "start": 8.41,
   "end": 9.67
  },
  {
   "text": "「この写真の",
   "start": 9.67,
   "end": 10.37
  },
  {
   "text": "食材で作れる",
   "start": 10.37,
   "end": 11.21
  },
  {
   "text": "夕飯を３つ考えて。",
   "start": 11.21,
   "end": 13.01
  },
  {
   "text": "20分以内で",
   "start": 13.01,
   "end": 14.09
  },
  {
   "text": "材料と作り方も",
   "start": 14.09,
   "end": 14.99
  },
  {
   "text": "教えて」",
   "start": 14.99,
   "end": 16.1
  },
  {
   "text": "出てきた候補を",
   "start": 16.1,
   "end": 16.91
  },
  {
   "text": "子どもに見せて",
   "start": 16.91,
   "end": 18.1
  },
  {
   "text": "「この中だったら",
   "start": 18.1,
   "end": 18.99
  },
  {
   "text": "どれがいい？」",
   "start": 18.99,
   "end": 19.69
  },
  {
   "text": "と選んで",
   "start": 19.69,
   "end": 20.33
  },
  {
   "text": "もらうんです。",
   "start": 20.33,
   "end": 21.75
  },
  {
   "text": "「なんでもいい」と",
   "start": 21.75,
   "end": 22.69
  },
  {
   "text": "言われて",
   "start": 22.69,
   "end": 23.19
  },
  {
   "text": "生姜焼きを",
   "start": 23.19,
   "end": 23.78
  },
  {
   "text": "提案したのに",
   "start": 23.78,
   "end": 24.91
  },
  {
   "text": "「それは嫌」。",
   "start": 24.91,
   "end": 26.15
  },
  {
   "text": "なんでもいいって",
   "start": 26.15,
   "end": 26.79
  },
  {
   "text": "言ったじゃん、と",
   "start": 26.79,
   "end": 28.13
  },
  {
   "text": "イラッとしちゃう",
   "start": 28.13,
   "end": 28.87
  },
  {
   "text": "ときに使える",
   "start": 28.87,
   "end": 29.47
  },
  {
   "text": "方法です。",
   "start": 29.47,
   "end": 30.75
  },
  {
   "text": "親が一品ずつ",
   "start": 30.75,
   "end": 31.73
  },
  {
   "text": "提案して",
   "start": 31.73,
   "end": 32.54
  },
  {
   "text": "断られるたびに",
   "start": 32.54,
   "end": 33.39
  },
  {
   "text": "考え直す代わりに",
   "start": 33.39,
   "end": 34.63
  },
  {
   "text": "ChatGPTに",
   "start": 34.63,
   "end": 35.75
  },
  {
   "text": "候補をまとめて",
   "start": 35.75,
   "end": 36.47
  },
  {
   "text": "出してもらいます。",
   "start": 36.47,
   "end": 37.78
  },
  {
   "text": "家族の人数や",
   "start": 37.78,
   "end": 39.01
  },
  {
   "text": "苦手な食材",
   "start": 39.01,
   "end": 40.18
  },
  {
   "text": "「辛くしないで」",
   "start": 40.18,
   "end": 41.31
  },
  {
   "text": "「洗い物は",
   "start": 41.31,
   "end": 41.85
  },
  {
   "text": "少なめで」",
   "start": 41.85,
   "end": 42.52
  },
  {
   "text": "といった条件も",
   "start": 42.52,
   "end": 43.51
  },
  {
   "text": "一緒に伝えられます。",
   "start": 43.51,
   "end": 45.43
  },
  {
   "text": "写真では",
   "start": 45.43,
   "end": 45.97
  },
  {
   "text": "分かりにくい食材は",
   "start": 45.97,
   "end": 47.37
  },
  {
   "text": "名前や量を",
   "start": 47.37,
   "end": 48.29
  },
  {
   "text": "文字で補ってください。",
   "start": 48.29,
   "end": 50.02
  },
  {
   "text": "家にない材料が",
   "start": 50.02,
   "end": 51.03
  },
  {
   "text": "入っていたら",
   "start": 51.03,
   "end": 51.99
  },
  {
   "text": "「それを使わずに",
   "start": 51.99,
   "end": 52.75
  },
  {
   "text": "作れる？」と",
   "start": 52.75,
   "end": 53.6
  },
  {
   "text": "聞き直せます。",
   "start": 53.6,
   "end": 54.93
  },
  {
   "text": "自分が作れそうな",
   "start": 54.93,
   "end": 55.97
  },
  {
   "text": "候補を確認してから",
   "start": 55.97,
   "end": 57.2
  },
  {
   "text": "子どもと一緒に",
   "start": 57.2,
   "end": 58.09
  },
  {
   "text": "選ぶ。",
   "start": 58.09,
   "end": 58.84
  },
  {
   "text": "毎日の",
   "start": 58.84,
   "end": 59.79
  },
  {
   "text": "「何を作ろう」と",
   "start": 59.79,
   "end": 60.58
  },
  {
   "text": "考える手間を",
   "start": 60.58,
   "end": 61.61
  },
  {
   "text": "ChatGPTに",
   "start": 61.61,
   "end": 62.49
  },
  {
   "text": "手伝ってもらう",
   "start": 62.49,
   "end": 63.27
  },
  {
   "text": "使い方です。",
   "start": 63.27,
   "end": 64.33
  },
  {
   "text": "家事を時短して",
   "start": 64.33,
   "end": 65.569
  },
  {
   "text": "夜のひとり時間を",
   "start": 65.569,
   "end": 66.47
  },
  {
   "text": "増やしたい人は",
   "start": 66.47,
   "end": 67.41
  },
  {
   "text": "プロフィールから",
   "start": 67.41,
   "end": 68.05
  },
  {
   "text": "フォローしてください！",
   "start": 68.05,
   "end": 71.17
