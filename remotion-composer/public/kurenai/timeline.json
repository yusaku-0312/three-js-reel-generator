 "subtitles": [
  {
   "text": "どちらかというと",
   "start": 0.39,
   "end": 1.955
  },
  {
   "text": "茶色の紅茶ですが",
   "start": 1.955,
   "end": 2.79
  },
  {
   "text": "「紅」という漢字を",
   "start": 2.79,
   "end": 4.37
  },
  {
   "text": "使うのには",
   "start": 4.37,
   "end": 5.07
  },
  {
   "text": "理由があります。",
   "start": 5.07,
   "end": 6.77
  },
  {
   "text": "紅茶という名前は",
   "start": 6.77,
   "end": 7.95
  },
  {
   "text": "茶葉の色ではなく",
   "start": 7.95,
   "end": 9.21
  },
  {
   "text": "淹れたお茶の色から",
   "start": 9.21,
   "end": 10.39
  },
  {
   "text": "付けられました。",
   "start": 10.39,
   "end": 11.59
  },
  {
   "text": "マグカップでは",
   "start": 11.59,
   "end": 12.38
  },
  {
   "text": "茶色っぽく見えても",
   "start": 12.38,
   "end": 13.87
  },
  {
   "text": "白いカップに注いで",
   "start": 13.87,
   "end": 14.9
  },
  {
   "text": "光にかざすと",
   "start": 14.9,
   "end": 16.05
  },
  {
   "text": "透きとおった",
   "start": 16.05,
   "end": 16.57
  },
  {
   "text": "紅色なんです。",
   "start": 16.57,
   "end": 17.92
  },
  {
   "text": "この色を",
   "start": 17.92,
   "end": 18.83
  },
  {
   "text": "「水色」と",
   "start": 18.83,
   "end": 19.61
  },
  {
   "text": "呼びます。",
   "start": 19.61,
   "end": 20.86
  },
  {
   "text": "赤い色のもとは",
   "start": 20.86,
   "end": 21.95
  },
  {
   "text": "発酵で生まれる",
   "start": 21.95,
   "end": 22.99
  },
  {
   "text": "テアフラビン",
   "start": 22.99,
   "end": 23.62
  },
  {
   "text": "という成分です。",
   "start": 23.62,
   "end": 25.53
  },
  {
   "text": "いっぽう英語では",
   "start": 25.53,
   "end": 26.22
  },
  {
   "text": "黒っぽい茶葉の",
   "start": 26.22,
   "end": 27.07
  },
  {
   "text": "見た目から",
   "start": 27.07,
   "end": 27.75
  },
  {
   "text": "ブラックティーと",
   "start": 27.75,
   "end": 28.53
  },
  {
   "text": "呼ばれます。",
   "start": 28.53,
   "end": 29.91
  },
  {
   "text": "中国で「黒茶」は",
   "start": 29.91,
   "end": 31.73
  },
  {
   "text": "プーアル茶など",
   "start": 31.73,
   "end": 32.71
  },
  {
   "text": "別のお茶なんです。",
   "start": 32.71,
   "end": 34.39
  },
  {
   "text": "次に飲むときは",
   "start": 34.39,
   "end": 35.53
  },
  {
   "text": "白いカップで",
   "start": 35.53,
   "end": 36.49
  },
  {
   "text": "紅い色を",
   "start": 36.49,
   "end": 36.97
  },
  {
   "text": "確かめてみてください。",
   "start": 36.97,
   "end": 40.07
  }
