 "subtitles": [
  {
   "text": "南国の果物みたいな",
   "start": 0.45,
   "end": 1.73
  },
  {
   "text": "香りがする",
   "start": 1.73,
   "end": 2.69
  },
  {
   "text": "アイスティー。",
   "start": 2.69,
   "end": 3.93
  },
  {
   "text": "でも実は",
   "start": 3.93,
   "end": 4.93
  },
  {
   "text": "果物はひとつも",
   "start": 4.93,
   "end": 6.05
  },
  {
   "text": "入っていないんです。",
   "start": 6.05,
   "end": 7.53
  },
  {
   "text": "その名も",
   "start": 7.53,
   "end": 8.28
  },
  {
   "text": "パラダイスティー。",
   "start": 8.28,
   "end": 9.73
  },
  {
   "text": "ファミレスの",
   "start": 9.73,
   "end": 10.29
  },
  {
   "text": "ドリンクバーでも",
   "start": 10.29,
   "end": 11.07
  },
  {
   "text": "人気の",
   "start": 11.07,
   "end": 11.87
  },
  {
   "text": "30年以上続く",
   "start": 11.87,
   "end": 12.95
  },
  {
   "text": "ロングセラーです。",
   "start": 12.95,
   "end": 14.55
  },
  {
   "text": "香りの正体は",
   "start": 14.55,
   "end": 15.71
  },
  {
   "text": "紅茶にブレンドされた",
   "start": 15.71,
   "end": 17.08
  },
  {
   "text": "4種類の花。",
   "start": 17.08,
   "end": 18.83
  },
  {
   "text": "青いコーンフラワー",
   "start": 18.83,
   "end": 20.3
  },
  {
   "text": "オレンジの",
   "start": 20.3,
   "end": 20.95
  },
  {
   "text": "マリーゴールド",
   "start": 20.95,
   "end": 22.14
  },
  {
   "text": "赤いサフラワー",
   "start": 22.14,
   "end": 23.29
  },
  {
   "text": "そしてローズ。",
   "start": 23.29,
   "end": 24.83
  },
  {
   "text": "花びらと香りづけが",
   "start": 24.83,
   "end": 26.07
  },
  {
   "text": "重なって",
   "start": 26.07,
   "end": 27.03
  },
  {
   "text": "楽園のような",
   "start": 27.03,
   "end": 27.85
  },
  {
   "text": "華やかな香りに",
   "start": 27.85,
   "end": 28.77
  },
  {
   "text": "なるんです。",
   "start": 28.77,
   "end": 29.83
  },
  {
   "text": "しかも砂糖を使わない",
   "start": 29.83,
   "end": 31.43
  },
  {
   "text": "無糖で",
   "start": 31.43,
   "end": 32.15
  },
  {
   "text": "カロリーゼロ。",
   "start": 32.15,
   "end": 33.51
  },
  {
   "text": "冷やすと",
   "start": 33.51,
   "end": 34.03
  },
  {
   "text": "すっきり爽やか。",
   "start": 34.03,
   "end": 35.48
  },
  {
   "text": "ホットにすると",
   "start": 35.48,
   "end": 36.62
  },
  {
   "text": "紅茶のコクが",
   "start": 36.62,
   "end": 37.23
  },
  {
   "text": "際立ちます。",
   "start": 37.23,
   "end": 38.57
  },
