 "subtitles": [
  {
   "text": "「晩ごはん",
   "start": 0.41,
   "end": 1.01
  },
  {
   "text": "何がいい？」",
   "start": 1.01,
   "end": 2.03
  },
  {
   "text": "「なんでもいい」",
   "start": 2.03,
   "end": 3.27
  },
  {
   "text": "その返事に",
   "start": 3.27,
   "end": 4.07
  },
  {
   "text": "困って",
   "start": 4.07,
   "end": 4.35
  },
  {
   "text": "いませんか？",
   "start": 4.35,
   "end": 5.65
  },
  {
   "text": "そんなときは",
   "start": 5.65,
   "end": 6.44
  },
  {
   "text": "AIに",
   "start": 6.44,
   "end": 6.98
  },
  {
   "text": "献立を",
   "start": 6.98,
   "end": 7.44
  },
  {
   "text": "考えて",
   "start": 7.44,
   "end": 7.83
  },
  {
   "text": "もらいましょう。",
   "start": 7.83,
   "end": 9.06
  },
  {
   "text": "まず",
   "start": 9.06,
   "end": 9.83
  },
  {
   "text": "冷蔵庫の中を",
   "start": 9.83,
   "end": 10.67
  },
  {
   "text": "スマホで撮ります。",
   "start": 10.67,
   "end": 12.14
  },
  {
   "text": "その写真を",
   "start": 12.14,
   "end": 12.87
  },
  {
   "text": "AIに送って",
   "start": 12.87,
   "end": 14.31
  },
  {
   "text": "「この食材で",
   "start": 14.31,
   "end": 15.07
  },
  {
   "text": "作れる晩ごはんを",
   "start": 15.07,
   "end": 16.15
  },
  {
   "text": "3つ考えて」と",
   "start": 16.15,
   "end": 17.39
  },
  {
   "text": "頼みます。",
   "start": 17.39,
   "end": 18.67
  },
  {
   "text": "すると",
   "start": 18.67,
   "end": 19.47
  },
  {
   "text": "今ある食材で",
   "start": 19.47,
   "end": 20.27
  },
  {
   "text": "作れるメニューを",
   "start": 20.27,
   "end": 21.09
  },
  {
   "text": "すぐに",
   "start": 21.09,
   "end": 21.41
  },
  {
   "text": "出してくれます。",
   "start": 21.41,
   "end": 22.76
  },
  {
   "text": "アレルギーや",
   "start": 22.76,
   "end": 23.49
  },
  {
   "text": "苦手な食べ物も",
   "start": 23.49,
   "end": 24.25
  },
  {
   "text": "伝えると",
   "start": 24.25,
   "end": 25.07
  },
  {
   "text": "さらに安心です。",
   "start": 25.07,
   "end": 26.43
  },
  {
   "text": "できた候補は",
   "start": 26.43,
   "end": 27.43
  },
  {
   "text": "お子さんに見せて",
   "start": 27.43,
   "end": 28.29
  },
  {
   "text": "選んで",
   "start": 28.29,
   "end": 28.57
  },
  {
   "text": "もらいましょう。",
   "start": 28.57,
   "end": 29.73
  },
  {
   "text": "「なんでもいい」が",
   "start": 29.73,
   "end": 30.82
  },
  {
   "text": "「これがいい！」に",
   "start": 30.82,
   "end": 31.69
  },
  {
   "text": "変わります。",
   "start": 31.69,
   "end": 32.869
  },
  {
   "text": "自分で選んだ",
   "start": 32.869,
   "end": 33.57
  },
  {
   "text": "ごはんは",
   "start": 33.57,
   "end": 34.17
  },
  {
   "text": "食べる気持ちも",
   "start": 34.17,
   "end": 34.89
  },
  {
   "text": "高まりやすい",
   "start": 34.89,
   "end": 35.56
  },
  {
   "text": "とも言われます。",
   "start": 35.56,
   "end": 36.91
  },
  {
   "text": "献立に悩む時間も",
   "start": 36.91,
   "end": 38.19
  },
  {
   "text": "ぐっと減らせます。",
   "start": 38.19,
   "end": 39.87
  },
  {
   "text": "今夜さっそく",
   "start": 39.87,
   "end": 40.41
  },
  {
   "text": "冷蔵庫を",
   "start": 40.41,
   "end": 40.92
  },
  {
   "text": "撮ってみてください。",
   "start": 40.92,
   "end": 44.01
  }
 ],
